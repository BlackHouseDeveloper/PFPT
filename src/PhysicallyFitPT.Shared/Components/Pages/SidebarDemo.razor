@page "/components/sidebar"
@namespace PhysicallyFitPT.Shared.Components.Pages

<div class="component-demo">
    <h1>Sidebar Component</h1>
    <p>Responsive sidebar navigation for clinic management with collapsible states and mobile support.</p>

    <hr class="my-6" />

    <h2>Basic Sidebar</h2>
    <p>Expandable/collapsible navigation with patient and appointment sections.</p>

    <div class="demo-container rounded-lg border border-gray-200 bg-white p-4">
        <SidebarProvider DefaultOpen="true">
            <div style="display: flex; height: 400px; border-radius: 0.5rem; border: 1px solid #e5e7eb;">
                <Sidebar>
                    <SidebarHeader>
                        <div style="font-weight: 600; padding: 0.5rem 0;">Clinic Navigation</div>
                    </SidebarHeader>
                    
                    <SidebarContent>
                        <SidebarGroup>
                            <SidebarGroupLabel>Main</SidebarGroupLabel>
                            <SidebarGroupContent>
                                <SidebarMenu>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton IsActive="true">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                                <polyline points="9 22 9 12 15 12 15 22" />
                                            </svg>
                                            <span>Dashboard</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                </SidebarMenu>
                            </SidebarGroupContent>
                        </SidebarGroup>

                        <SidebarGroup>
                            <SidebarGroupLabel>Clinical</SidebarGroupLabel>
                            <SidebarGroupContent>
                                <SidebarMenu>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton>
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                                <circle cx="9" cy="7" r="4" />
                                                <path d="M22 16c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2z" />
                                                <path d="M22 12v6M19 15h6" />
                                            </svg>
                                            <span>Patients</span>
                                        </SidebarMenuButton>
                                        <SidebarMenuSub>
                                            <SidebarMenuSubItem>
                                                <SidebarMenuSubButton Href="#" IsActive="false">
                                                    <span>Active</span>
                                                </SidebarMenuSubButton>
                                            </SidebarMenuSubItem>
                                            <SidebarMenuSubItem>
                                                <SidebarMenuSubButton Href="#" IsActive="false">
                                                    <span>Discharged</span>
                                                </SidebarMenuSubButton>
                                            </SidebarMenuSubItem>
                                        </SidebarMenuSub>
                                    </SidebarMenuItem>

                                    <SidebarMenuItem>
                                        <SidebarMenuButton>
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                                                <line x1="16" y1="2" x2="16" y2="6" />
                                                <line x1="8" y1="2" x2="8" y2="6" />
                                                <line x1="3" y1="10" x2="21" y2="10" />
                                            </svg>
                                            <span>Appointments</span>
                                        </SidebarMenuButton>
                                        <SidebarMenuSub>
                                            <SidebarMenuSubItem>
                                                <SidebarMenuSubButton Href="#" IsActive="false">
                                                    <span>Today</span>
                                                </SidebarMenuSubButton>
                                            </SidebarMenuSubItem>
                                            <SidebarMenuSubItem>
                                                <SidebarMenuSubButton Href="#" IsActive="false">
                                                    <span>Upcoming</span>
                                                </SidebarMenuSubButton>
                                            </SidebarMenuSubItem>
                                        </SidebarMenuSub>
                                    </SidebarMenuItem>

                                    <SidebarMenuItem>
                                        <SidebarMenuButton>
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                                <polyline points="14 2 14 8 20 8" />
                                                <line x1="12" y1="11" x2="12" y2="17" />
                                                <line x1="9" y1="14" x2="15" y2="14" />
                                            </svg>
                                            <span>SOAP Notes</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                </SidebarMenu>
                            </SidebarGroupContent>
                        </SidebarGroup>

                        <SidebarGroup>
                            <SidebarGroupLabel>Reports</SidebarGroupLabel>
                            <SidebarGroupContent>
                                <SidebarMenu>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton>
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="12" y1="2" x2="12" y2="22" />
                                                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                                            </svg>
                                            <span>Outcomes</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton>
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="18" y1="20" x2="18" y2="10" />
                                                <line x1="12" y1="20" x2="12" y2="4" />
                                                <line x1="6" y1="20" x2="6" y2="14" />
                                            </svg>
                                            <span>Analytics</span>
                                        </SidebarMenuButton>
                                    </SidebarMenuItem>
                                </SidebarMenu>
                            </SidebarGroupContent>
                        </SidebarGroup>
                    </SidebarContent>

                    <SidebarFooter>
                        <SidebarMenu>
                            <SidebarMenuItem>
                                <SidebarMenuButton>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                                        <polyline points="17 21 17 13 7 13 7 21" />
                                        <polyline points="7 5 7 13 17 13" />
                                    </svg>
                                    <span>Settings</span>
                                </SidebarMenuButton>
                            </SidebarMenuItem>
                        </SidebarMenu>
                    </SidebarFooter>
                </Sidebar>

                <div style="flex: 1; padding: 1rem; background: #f9fafb; display: flex; flex-direction: column; justify-content: center; align-items: center;">
                    <p style="color: #6b7280; font-size: 0.875rem;">Content area</p>
                    <p style="color: #9ca3af; margin-top: 0.5rem;">Select a menu item to navigate</p>
                </div>
            </div>
        </SidebarProvider>
    </div>

    <hr class="my-6" />

    <h2>Sidebar with Trigger</h2>
    <p>Sidebar trigger button for toggling the sidebar on desktop and mobile.</p>

    <div class="demo-container rounded-lg border border-gray-200 bg-white p-4">
        <SidebarProvider DefaultOpen="true">
            <div style="display: flex; height: 300px; border-radius: 0.5rem; border: 1px solid #e5e7eb;">
                <Sidebar>
                    <SidebarHeader>
                        <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.5rem;">
                            <SidebarTrigger />
                            <span style="font-weight: 600;">Menu</span>
                        </div>
                    </SidebarHeader>
                    <SidebarContent>
                        <SidebarGroup>
                            <SidebarGroupContent>
                                <SidebarMenu>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton IsActive="true">Dashboard</SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton>Patients</SidebarMenuButton>
                                    </SidebarMenuItem>
                                    <SidebarMenuItem>
                                        <SidebarMenuButton>Notes</SidebarMenuButton>
                                    </SidebarMenuItem>
                                </SidebarMenu>
                            </SidebarGroupContent>
                        </SidebarGroup>
                    </SidebarContent>
                </Sidebar>

                <div style="flex: 1; padding: 1rem; background: #f9fafb; display: flex; flex-direction: column; justify-content: center; align-items: center;">
                    <p style="color: #6b7280; font-size: 0.875rem;">Click the sidebar trigger to toggle</p>
                </div>
            </div>
        </SidebarProvider>
    </div>

    <hr class="my-6" />

    <h2>Features</h2>
    <ul class="component-feature-list">
        <li><strong>Responsive Design:</strong> Adapts to desktop (fixed) and mobile (sheet overlay)</li>
        <li><strong>Collapsible:</strong> Three collapsible modes: offcanvas, icon, none</li>
        <li><strong>Context-Based State:</strong> Uses cascading values for sidebar state management</li>
        <li><strong>Menu Hierarchy:</strong> Support for submenus and nested navigation</li>
        <li><strong>Accessibility:</strong> Proper ARIA labels, keyboard navigation, and semantic HTML</li>
        <li><strong>Variant Support:</strong> Multiple sidebar variants (sidebar, floating, inset)</li>
        <li><strong>Side Placement:</strong> Can be positioned on left or right</li>
        <li><strong>Grouped Sections:</strong> Organize menu items into logical groups with labels</li>
    </ul>
</div>

<style>
    .component-demo {
        padding: 2rem;
    }

    .component-demo h1 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .component-demo h2 {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1rem;
        margin-top: 2rem;
    }

    .component-demo p {
        color: #6b7280;
        margin-bottom: 1rem;
    }

    .demo-container {
        overflow: hidden;
    }

    .component-feature-list {
        list-style: disc;
        margin-left: 1.5rem;
        color: #6b7280;
    }

    .component-feature-list li {
        margin-bottom: 0.75rem;
    }

    .my-6 {
        margin-top: 1.5rem;
        margin-bottom: 1.5rem;
        border: none;
        border-top: 1px solid #e5e7eb;
    }
</style>
