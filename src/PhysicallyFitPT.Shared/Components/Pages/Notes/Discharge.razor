@page "/notes/discharge"
@layout ResponsiveMainLayout
@using PhysicallyFitPT.Shared.Components.UI
@using PhysicallyFitPT.Shared.Components.SOAP

<PageTitle>Discharge Note</PageTitle>

<DebugStatBar />

<div class="pfp-note-page">
  <div class="pfp-page-header">
    <div class="pfp-header-content">
      <div>
        <h2>🎓 Discharge Summary</h2>
        <p>Final treatment summary and outcomes</p>
      </div>
      <div class="pfp-note-actions">
        <Button 
          Variant="outline" 
          Icon="💾"
          Text="Save Draft"
          OnClick="SaveDraft" />
        <Button 
          Variant="primary" 
          Icon="✅"
          Text="Sign & Submit"
          OnClick="SignAndSubmit" />
      </div>
    </div>
  </div>

  @if (!string.IsNullOrEmpty(statusMessage))
  {
    <div class="pfp-alert @(isError ? "pfp-alert-error" : "pfp-alert-success")">
      @statusMessage
    </div>
  }

  <!-- Patient Info Bar -->
  <div class="pfp-patient-info-bar">
    <div class="pfp-patient-quick-info">
      <span class="pfp-info-item">
        <strong>Patient:</strong> @selectedPatientName
      </span>
      <span class="pfp-info-item">
        <strong>Date:</strong> @DateTime.Today.ToString("MM/dd/yyyy")
      </span>
      <span class="pfp-info-item">
        <strong>Note Type:</strong> Discharge Summary
      </span>
      <span class="pfp-info-item">
        <strong>Total Visits:</strong> @totalVisits
      </span>
    </div>
    <Button 
      Variant="outline" 
      Size="small"
      Icon="🔍"
      Text="Select Patient"
      OnClick="SelectPatient" />
  </div>

  <!-- Discharge Summary -->
  <div class="pfp-soap-note">
    <!-- Treatment Summary -->
    <div class="pfp-card">
      <div class="pfp-card-header">
        <h3>📋 Treatment Summary</h3>
      </div>
      <div class="pfp-card-body">
        <div class="pfp-form-grid">
          <FormField 
            Label="Date of Initial Evaluation"
            Type="date"
            @bind-Value="@initialEvalDate" />
          
          <FormField 
            Label="Date of Discharge"
            Type="date"
            @bind-Value="@dischargeDate" />
          
          <FormField 
            Label="Total Visits Attended"
            Type="number"
            @bind-Value="@totalVisitsString" />
          
          <FormField 
            Label="Frequency"
            @bind-Value="@treatmentFrequency"
            Placeholder="e.g., 3x/week for 6 weeks" />
        </div>

        <FormField 
          Label="Diagnosis & Treatment Focus"
          Type="textarea"
          @bind-Value="@diagnosisAndTreatment"
          Rows="3"
          HelpText="ICD-10 codes and primary treatment focus" />
      </div>
    </div>

    <!-- Initial vs Final Comparison -->
    <div class="pfp-card">
      <div class="pfp-card-header">
        <h3>📊 Outcome Measures: Initial vs Final</h3>
      </div>
      <div class="pfp-card-body">
        <div class="pfp-comparison-table">
          <div class="pfp-comparison-header">
            <span>Measure</span>
            <span>Initial</span>
            <span>Final</span>
            <span>Change</span>
          </div>
          @foreach (var outcome in outcomes)
          {
            <div class="pfp-comparison-row">
              <span class="pfp-comparison-name">@outcome.Measure</span>
              <span class="pfp-comparison-initial">@outcome.Initial</span>
              <span class="pfp-comparison-current">@outcome.Final</span>
              <span class="pfp-comparison-delta pfp-improvement">
                ↑ @outcome.Improvement
              </span>
            </div>
          }
        </div>

        <Button 
          Variant="outline" 
          Icon="➕"
          Text="Add Outcome Measure"
          OnClick="AddOutcome" />
      </div>
    </div>

    <!-- Goals Achievement -->
    <div class="pfp-card">
      <div class="pfp-card-header">
        <h3>🎯 Goals Achievement Summary</h3>
      </div>
      <div class="pfp-card-body">
        <div class="pfp-goals-achievement">
          @foreach (var goal in dischargeGoals)
          {
            <div class="pfp-discharge-goal">
              <div class="pfp-discharge-goal-header">
                <strong>@goal.Description</strong>
                <select @bind="goal.AchievementStatus" class="pfp-goal-status-select">
                  <option value="Fully Achieved">✅ Fully Achieved</option>
                  <option value="Partially Achieved">🟡 Partially Achieved</option>
                  <option value="Not Achieved">❌ Not Achieved</option>
                  <option value="Modified">🔄 Modified</option>
                </select>
              </div>
              <p class="pfp-goal-detail">@goal.Details</p>
            </div>
          }
        </div>
      </div>
    </div>

    <!-- Discharge Status -->
    <div class="pfp-card">
      <div class="pfp-card-header">
        <h3>🏁 Discharge Status</h3>
      </div>
      <div class="pfp-card-body">
        <FormField 
          Label="Reason for Discharge"
          Type="select"
          @bind-Value="@dischargeReason">
          <SelectOptions>
            <option value="">Select...</option>
            <option value="Goals Met">✅ Goals Met</option>
            <option value="Maximum Benefit">✅ Maximum Benefit Achieved</option>
            <option value="Patient Request">👤 Patient Request</option>
            <option value="Insurance Limit">💳 Insurance Visits Exhausted</option>
            <option value="Referral">➡️ Referral to Other Provider</option>
            <option value="Non-Compliance">⚠️ Non-Compliance</option>
          </SelectOptions>
        </FormField>

        <FormField 
          Label="Functional Status at Discharge"
          Type="textarea"
          @bind-Value="@functionalStatus"
          Rows="3"
          HelpText="Describe patient's current functional abilities and independence level" />

        <FormField 
          Label="Prognosis"
          Type="select"
          @bind-Value="@prognosis">
          <SelectOptions>
            <option value="">Select...</option>
            <option value="Excellent">Excellent - Full recovery expected</option>
            <option value="Good">Good - Continued improvement expected</option>
            <option value="Fair">Fair - Stable with current management</option>
            <option value="Guarded">Guarded - May require further intervention</option>
          </SelectOptions>
        </FormField>
      </div>
    </div>

    <!-- Recommendations -->
    <div class="pfp-card">
      <div class="pfp-card-header">
        <h3>💡 Discharge Recommendations</h3>
      </div>
      <div class="pfp-card-body">
        <FormField 
          Label="Home Exercise Program"
          Type="textarea"
          @bind-Value="@hepRecommendations"
          Rows="4"
          HelpText="Summarize HEP for patient to continue independently" />

        <FormField 
          Label="Activity Modifications & Precautions"
          Type="textarea"
          @bind-Value="@activityModifications"
          Rows="3"
          HelpText="Any activity restrictions or safety precautions" />

        <FormField 
          Label="Follow-up Recommendations"
          Type="textarea"
          @bind-Value="@followUpRecommendations"
          Rows="2"
          HelpText="Return to PT if..., follow-up with physician, etc." />
      </div>
    </div>
  </div>

  <!-- Note Footer Actions -->
  <div class="pfp-note-footer">
    <div class="pfp-note-footer-info">
      <small>Last saved: @lastSavedTime</small>
    </div>
    <div class="pfp-note-footer-actions">
      <Button 
        Variant="secondary" 
        Icon="🗑️"
        Text="Discard"
        OnClick="DiscardNote" />
      <Button 
        Variant="outline" 
        Icon="👁️"
        Text="Preview"
        OnClick="PreviewNote" />
      <Button 
        Variant="primary" 
        Icon="✅"
        Text="Sign & Submit"
        Loading="@isSubmitting"
        OnClick="SignAndSubmit" />
    </div>
  </div>
</div>

@code {
  private string selectedPatientName = "Select a patient";
  private int totalVisits = 12;
  private string? statusMessage = null;
  private bool isError = false;
  private string lastSavedTime = "Never";
  private bool isSubmitting = false;

  private string initialEvalDate = DateTime.Today.AddDays(-45).ToString("yyyy-MM-dd");
  private string dischargeDate = DateTime.Today.ToString("yyyy-MM-dd");
  private string totalVisitsString = "12";
  private string treatmentFrequency = "3x/week for 6 weeks";
  private string diagnosisAndTreatment = string.Empty;
  private string functionalStatus = string.Empty;
  private string prognosis = string.Empty;
  private string dischargeReason = string.Empty;
  private string hepRecommendations = string.Empty;
  private string activityModifications = string.Empty;
  private string followUpRecommendations = string.Empty;

  private List<OutcomeMeasure> outcomes = new()
  {
    new OutcomeMeasure { Measure = "Pain Level (VAS)", Initial = "8/10", Final = "2/10", Improvement = "75% reduction" },
    new OutcomeMeasure { Measure = "Shoulder Flexion ROM", Initial = "90°", Final = "165°", Improvement = "83% increase" },
    new OutcomeMeasure { Measure = "Deltoid Strength (MMT)", Initial = "3/5", Final = "5/5", Improvement = "Full strength" },
  };

  private List<DischargeGoal> dischargeGoals = new()
  {
    new DischargeGoal 
    { 
      Description = "Patient will demonstrate 160° shoulder flexion without pain",
      AchievementStatus = "Fully Achieved",
      Details = "Patient achieved 165° flexion with 0/10 pain"
    },
    new DischargeGoal 
    { 
      Description = "Patient will lift 15 lbs overhead for work tasks",
      AchievementStatus = "Fully Achieved",
      Details = "Patient able to lift 20 lbs overhead without difficulty"
    },
  };

  private class OutcomeMeasure
  {
    public string Measure { get; set; } = string.Empty;
    public string Initial { get; set; } = string.Empty;
    public string Final { get; set; } = string.Empty;
    public string Improvement { get; set; } = string.Empty;
  }

  private class DischargeGoal
  {
    public string Description { get; set; } = string.Empty;
    public string AchievementStatus { get; set; } = string.Empty;
    public string Details { get; set; } = string.Empty;
  }

  private void AddOutcome()
  {
    outcomes.Add(new OutcomeMeasure());
  }

  private void SelectPatient()
  {
    Console.WriteLine("Select patient for discharge note");
    selectedPatientName = "John Doe";
  }

  private void SaveDraft()
  {
    lastSavedTime = DateTime.Now.ToString("h:mm tt");
    statusMessage = "Draft saved successfully";
    isError = false;
  }

  private void SignAndSubmit()
  {
    isSubmitting = true;
    try
    {
      statusMessage = "Discharge note signed and submitted successfully!";
      isError = false;
    }
    catch (Exception ex)
    {
      statusMessage = $"Failed to submit note: {ex.Message}";
      isError = true;
    }
    finally
    {
      isSubmitting = false;
    }
  }

  private void PreviewNote()
  {
    Console.WriteLine("Preview note");
  }

  private void DiscardNote()
  {
    Console.WriteLine("Note discarded");
  }
}
