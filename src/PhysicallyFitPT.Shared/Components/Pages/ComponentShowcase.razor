    private string GetNavButtonClass(string sectionId)
    {
        var baseClass = "w-full text-left px-3 py-2 rounded-md text-sm flex items-center gap-2 transition-colors";
        var activeClass = activeSection == sectionId 
            ? "bg-primary text-primary-foreground font-medium" 
            : "text-gray-700 hover:bg-gray-100";
        return $"{baseClass} {activeClass}";
    }

