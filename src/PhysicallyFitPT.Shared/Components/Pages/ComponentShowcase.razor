@page "/component-showcase"
@* 
    Component Showcase - Test page for all UI components ported from Make
    Use this to test and verify component behavior as they're implemented
*@
@using PhysicallyFitPT.Shared.Components.UI.Command
@using PhysicallyFitPT.Shared.Components.UI.ContextMenu
@using PhysicallyFitPT.Shared.Components.UI.DatePicker
@using PhysicallyFitPT.Shared.Components.UI.Dialog
@using PhysicallyFitPT.Shared.Components.UI.Drawer

<div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <div class="bg-white border-b sticky top-0 z-10">
        <div class="container mx-auto px-6 py-4">
            <h1 class="text-2xl font-bold text-gray-900">PFPT Component Showcase</h1>
            <p class="text-sm text-gray-600 mt-1">Test and verify UI components ported from Make prototype</p>
        </div>
    </div>

    <div class="container mx-auto px-6 py-8">
        <div class="grid lg:grid-cols-12 gap-8">
            <!-- Sidebar Navigation -->
            <aside class="lg:col-span-3">
                <nav class="bg-white rounded-lg shadow-sm p-4 sticky top-24">
                    <h2 class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-4">Components</h2>
                    <ul class="space-y-1">
                        @foreach (var component in sections)
                        {
                            <li>
                                <button 
                                    @onclick="() => ScrollToSection(component.Id)"
                                    class="@GetNavButtonClass(component.Id)">
                                    <span class="@(component.Completed ? "text-green-600" : "text-gray-400")">
                                        @(component.Completed ? "✓" : "○")
                                    </span>
                                    @component.Name
                                </button>
                            </li>
                        }
                    </ul>

                    <div class="mt-6 pt-6 border-t">
                        <div class="text-xs text-gray-500">
                            <p class="font-semibold mb-2">Progress</p>
                            <div class="flex items-center gap-2">
                                <div class="flex-1 bg-gray-200 rounded-full h-2">
                                    <div class="bg-green-600 h-2 rounded-full transition-all" style="width: @(completionPercentage)%"></div>
                                </div>
                                <span class="font-mono">@completedCount/@totalCount</span>
                            </div>
                        </div>
                    </div>
                </nav>
            </aside>

            <!-- Main Content -->
            <main class="lg:col-span-9 space-y-8">
                
                <!-- Accordion Section -->
                <section id="accordion" class="bg-white rounded-lg shadow-sm p-6">
                    <div class="mb-6">
                        <div class="flex items-center justify-between mb-2">
                            <h2 class="text-xl font-bold text-gray-900">Accordion</h2>
                            <span class="px-2 py-1 bg-green-100 text-green-800 text-xs font-semibold rounded">Completed</span>
                        </div>
                        <p class="text-sm text-gray-600">Collapsible sections with smooth animations and keyboard navigation</p>
                    </div>

                    <div class="space-y-8">
                        <!-- Single Mode -->
                        <div>
                            <h3 class="text-sm font-semibold text-gray-700 mb-3">Single Mode (One at a time)</h3>
                            <Accordion Type="single" Collapsible="true">
                                <AccordionItem Value="single-1">
                                    <AccordionTrigger>Is it accessible?</AccordionTrigger>
                                    <AccordionContent>
                                        Yes. It adheres to the WAI-ARIA design pattern with full keyboard navigation support.
                                    </AccordionContent>
                                </AccordionItem>
                                <AccordionItem Value="single-2">
                                    <AccordionTrigger>Is it styled?</AccordionTrigger>
                                    <AccordionContent>
                                        Yes. It comes with default styles that match your design system.
                                    </AccordionContent>
                                </AccordionItem>
                                <AccordionItem Value="single-3">
                                    <AccordionTrigger>Can it be animated?</AccordionTrigger>
                                    <AccordionContent>
                                        Yes. It uses CSS animations for smooth transitions.
                                    </AccordionContent>
                                </AccordionItem>
                            </Accordion>
                        </div>

                        <!-- Multiple Mode -->
                        <div>
                            <h3 class="text-sm font-semibold text-gray-700 mb-3">Multiple Mode (Multiple open)</h3>
                            <Accordion Type="multiple">
                                <AccordionItem Value="multi-1">
                                    <AccordionTrigger>Feature One</AccordionTrigger>
                                    <AccordionContent>Multiple accordions can be open at the same time.</AccordionContent>
                                </AccordionItem>
                                <AccordionItem Value="multi-2">
                                    <AccordionTrigger>Feature Two</AccordionTrigger>
                                    <AccordionContent>Each section maintains its own state independently.</AccordionContent>
                                </AccordionItem>
                            </Accordion>
                        </div>

                        <!-- Disabled State -->
                        <div>
                            <h3 class="text-sm font-semibold text-gray-700 mb-3">Disabled State</h3>
                            <Accordion Type="single">
                                <AccordionItem Value="disabled-1">
                                    <AccordionTrigger Disabled="true">Disabled Trigger</AccordionTrigger>
                                    <AccordionContent>This content is not accessible.</AccordionContent>
                                </AccordionItem>
                            </Accordion>
                        </div>
                    </div>
                </section>

                <!-- Alert Section -->
                <section id="alert" class="bg-white rounded-lg shadow-sm p-6">
                    <div class="mb-6">
                        <div class="flex items-center justify-between mb-2">
                            <h2 class="text-xl font-bold text-gray-900">Alert</h2>
                            <span class="px-2 py-1 bg-green-200 text-green-800 text-xs font-semibold rounded">Completed</span>
                        </div>
                        <p class="text-sm text-gray-600">Banner component for displaying important messages</p>
