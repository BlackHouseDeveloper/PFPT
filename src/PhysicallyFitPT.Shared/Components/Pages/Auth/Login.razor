@page "/login"
@layout AuthLayout
@inject IUserService UserService
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Logging.ILogger<Login> Logger
@using Microsoft.Extensions.Logging

<PageTitle>Login</PageTitle>

<DebugStatBar />

<div class="auth-shell">
  <div class="auth-brand">PTDoc</div>

  <div class="auth-card" aria-live="polite">
    <header class="auth-card-header">
      <p class="auth-welcome">Welcome</p>
      <div class="auth-tabs">
        <button type="button" class="auth-tab active">Login</button>
        <button type="button" class="auth-tab" disabled aria-disabled="true">Sign Up</button>
      </div>
    </header>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
      <div class="auth-alert" role="alert">
        <span class="auth-alert-title">Login failed</span>
        <span>@errorMessage</span>
      </div>
    }

    <EditForm Model="loginModel" OnValidSubmit="HandleLogin" class="auth-form" aria-busy="@isLoading">
      <DataAnnotationsValidator />

      <div class="auth-field">
        <label for="pin">4-Digit PIN</label>
        <InputText id="pin"
                   type="password"
                   class="auth-input"
                   placeholder="Enter 4-digit PIN"
                   autocomplete="off"
                   maxlength="4"
                   aria-describedby="pin-error"
                   @bind-Value="loginModel.Pin" />
        <ValidationMessage id="pin-error" For="@(() => loginModel.Pin)" class="auth-validation" />
      </div>

      <div class="auth-actions">
        <button type="button" class="auth-link" disabled="@isLoading">Forgot PIN?</button>
      </div>

      <button type="submit" class="auth-primary" disabled="@isLoading">
        @if (isLoading)
        {
          <span>Authenticating...</span>
        }
        else
        {
          <span>Login</span>
        }
      </button>

      <div class="auth-hint" aria-live="polite">
        <p class="auth-hint-title">Demo credentials (Week 2)</p>
        <p>PIN: 1234</p>
      </div>
    </EditForm>
  </div>

  <footer class="auth-footnote" aria-live="polite">
    <span>🔒 HIPAA-compliant secure access</span>
    <span>Protected health information</span>
  </footer>
</div>

@code {
  private readonly LoginModel loginModel = new();
  private string? errorMessage;
  private bool isLoading;

  private async Task HandleLogin()
  {
    isLoading = true;
    errorMessage = null;
    StateHasChanged();

    try
    {
      await Task.Delay(500);

      // PIN-based authentication: use PIN as both username and password for now
      var success = await UserService.LoginAsync(loginModel.Pin, loginModel.Pin);

      if (success)
      {
        Navigation.NavigateTo("/");
      }
      else
      {
        errorMessage = "Invalid PIN. Please try again.";
        loginModel.Pin = string.Empty;
      }
    }
    catch (Exception ex)
    {
      Logger.LogError(ex, "Login failed");
      errorMessage = "We couldn't sign you in. Please try again.";
    }
    finally
    {
      isLoading = false;
      StateHasChanged();
    }
  }

  private sealed class LoginModel
  {
    [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "PIN is required")]
    [System.ComponentModel.DataAnnotations.StringLength(4, MinimumLength = 4, ErrorMessage = "PIN must be 4 digits")]
    [System.ComponentModel.DataAnnotations.RegularExpression(@"^\d{4}$", ErrorMessage = "PIN must be 4 digits")]
    public string Pin { get; set; } = string.Empty;
  }
}
