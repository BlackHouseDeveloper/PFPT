@page "/patients"
@layout ResponsiveMainLayout
@inject IDataService DataService
@inject IJSRuntime JSRuntime
@using PhysicallyFitPT.Shared.Components.UI

<PageTitle>Patients</PageTitle>

<DebugStatBar />

<div class="pfp-page-header">
  <div class="pfp-header-content">
    <div>
      <h2>Patients</h2>
      <p>Manage patient records and information</p>
    </div>
    <Button 
      Variant="primary" 
      Icon="👤"
      Text="Add Patient"
      OnClick="NavigateToIntake" />
  </div>
</div>

<div class="pfp-card">
  <div class="pfp-card-header">
    <h3>Patient Search</h3>
  </div>
  <div class="pfp-card-body">
    <div class="pfp-search-section">
      <FormField 
        @bind-Value="@searchQuery"
        Placeholder="Search patients by name..."
        Type="text">
      </FormField>
      <Button 
        OnClick="SearchPatients" 
        Loading="@isLoading"
        Text="Search"
        Icon="🔍" />
    </div>

    @if (errorMessage != null)
    {
      <div class="pfp-alert pfp-alert-error">
        @errorMessage
      </div>
    }

    @if (patients.Any())
    {
      <div class="pfp-results-header">
        <span>Found @patients.Count() patients</span>
      </div>
      
      <div class="pfp-patient-grid">
        @foreach (var patient in patients)
        {
          <PatientCard 
            Patient="@patient" 
            ShowDetails="true"
            ShowActions="true"
            OnClick="@((p) => ViewPatient(p.Id))">
            <Actions>
              <Button 
                Variant="outline" 
                Size="small"
                Text="View"
                Icon="👁️"
                OnClick="@(() => ViewPatient(patient.Id))" />
              <Button 
                Variant="secondary" 
                Size="small"
                Text="Schedule"
                Icon="📅"
                OnClick="@(() => ScheduleAppointment(patient.Id))" />
            </Actions>
          </PatientCard>
        }
      </div>
    }
    else if (!isLoading && hasSearched)
    {
      <div class="pfp-no-results">
        <p>No patients found matching your search criteria.</p>
        <p><small>Try adjusting your search terms or check the spelling.</small></p>
      </div>
    }
    else if (!hasSearched)
    {
      <div class="pfp-getting-started">
        <p>Enter a patient name in the search box above to get started.</p>
        <p><small>You can search by first name, last name, or both.</small></p>
      </div>
    }
  </div>
</div>

@code {
    private string searchQuery = string.Empty;
    private IEnumerable<PatientDto> patients = Enumerable.Empty<PatientDto>();
    private bool isLoading = false;
    private bool hasSearched = false;
    private string? errorMessage = null;

    private async Task SearchPatients()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            return;
        }

        isLoading = true;
        hasSearched = true;
        errorMessage = null;

        try
        {
            patients = await DataService.SearchPatientsAsync(searchQuery, take: 50);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to search patients: {ex.Message}";
            patients = Enumerable.Empty<PatientDto>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchPatients();
        }
    }

    private void ViewPatient(Guid patientId)
    {
        // NavigationManager.NavigateTo($"/patients/{patientId}");
        Console.WriteLine($"View patient: {patientId}");
    }

    private void ScheduleAppointment(Guid patientId)
    {
        // NavigationManager.NavigateTo($"/appointments/new?patientId={patientId}");
        Console.WriteLine($"Schedule appointment for patient: {patientId}");
    }
    
    private void NavigateToIntake()
    {
        // NavigationManager.NavigateTo("/intake");
        Console.WriteLine("Navigate to intake");
    }
}
