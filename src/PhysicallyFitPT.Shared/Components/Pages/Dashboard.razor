@* Dashboard page with responsive layout *@
@page "/"
@page "/dashboard"
@layout ResponsiveMainLayout
@inject IDataService DataService
@using PhysicallyFitPT.Shared.Components.UI

<DebugStatBar />

<div class="pfp-dashboard">
  <div class="pfp-page-header">
    <h2>Dashboard</h2>
    <p>Welcome to Physically Fit PT</p>
  </div>

  @if (isLoading)
  {
    <div class="pfp-loading">Loading dashboard...</div>
  }
  else
  {
    <div class="pfp-dashboard-grid">
      <StatCard 
        Title="Today's Appointments" 
        Value="@dashboardStats.TodaysAppointments.ToString()"
        Label="Scheduled"
        Icon="📅" />
      
      <StatCard 
        Title="Active Patients" 
        Value="@dashboardStats.ActivePatients.ToString()"
        Label="Total"
        Icon="👥" />
      
      <StatCard 
        Title="Pending Notes" 
        Value="@dashboardStats.PendingNotes.ToString()"
        Label="To Complete"
        Icon="📝" />
      
      <StatCard 
        Title="PN Due" 
        Value="@dashboardStats.OverdueOutcomeMeasures.ToString()"
        Label="Overdue"
        Icon="⚠️" />
    </div>
      
    <div class="pfp-card pfp-card-wide">
      <div class="pfp-card-header">
        <h3>Quick Actions</h3>
      </div>
      <div class="pfp-card-body">
        <div class="pfp-quick-actions">
          <Button 
            Variant="primary" 
            Icon="👥"
            Text="View Patients"
            OnClick="@(() => NavigateToPatients())" />
          
          <Button 
            Variant="secondary" 
            Icon="📅"
            Text="Schedule Appointment"
            OnClick="@(() => NavigateToAppointments())" />
          
          <Button 
            Variant="secondary" 
            Icon="📝"
            Text="New Eval Note"
            OnClick="@(() => NavigateToNewNote())" />
          
          <Button 
            Variant="outline" 
            Icon="📊"
            Text="View Reports"
            OnClick="@(() => NavigateToReports())" />
        </div>
      </div>
    </div>
  }

  @if (errorMessage != null)
  {
    <div class="pfp-alert pfp-alert-error">
      @errorMessage
      <Button Variant="text" OnClick="RefreshDashboard">
        🔄 Retry
      </Button>
    </div>
  }
</div>

@code {
    private DashboardStatsDto dashboardStats = new();
    private bool isLoading = true;
    private string? errorMessage = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardStats();
    }

    private async Task LoadDashboardStats()
    {
        isLoading = true;
        errorMessage = null;
        
        try
        {
            dashboardStats = await DataService.GetDashboardStatsAsync();
        }
        catch (Exception)
        {
            errorMessage = "Failed to load dashboard statistics. Please check your connection and try again.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshDashboard()
    {
        await LoadDashboardStats();
    }
    
    private void NavigateToPatients()
    {
        // NavigationManager.NavigateTo("/patients");
        Console.WriteLine("Navigate to patients");
    }
    
    private void NavigateToAppointments()
    {
        // NavigationManager.NavigateTo("/appointments");
        Console.WriteLine("Navigate to appointments");
    }
    
    private void NavigateToNewNote()
    {
        // NavigationManager.NavigateTo("/notes/eval");
        Console.WriteLine("Navigate to new note");
    }
    
    private void NavigateToReports()
    {
        // NavigationManager.NavigateTo("/reports");
        Console.WriteLine("Navigate to reports");
    }
}
