  protected override async Task OnInitializedAsync()
  {
    await LoadDashboard();
  }

  private async Task LoadDashboard()
  {
    isLoading = true;
    errorMessage = null;
    try
    {
      await Task.Delay(500);
    }
    catch (Exception)
    {
      errorMessage = "Failed to load dashboard";
    }
    finally
    {
      isLoading = false;
      StateHasChanged();
    }
  }

  private async Task RefreshDashboard()
  {
    await LoadDashboard();
  }

