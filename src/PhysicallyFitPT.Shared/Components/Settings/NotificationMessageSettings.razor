                            <option value="4">4 hours</option>
                            <option value="8">8 hours</option>
                            <option value="24">24 hours (Recommended)</option>
                            <option value="48">48 hours</option>
                        </select>
                        <p class="text-xs text-muted-foreground mt-2">
