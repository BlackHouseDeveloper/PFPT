@namespace PhysicallyFitPT.Shared.Components.Settings

<Tabs DefaultValue="clinical-alerts" Class="w-full">
    <TabsList Class="grid w-full grid-cols-2 md:grid-cols-4 mb-6">
        <TabsTrigger Value="clinical-alerts" Class="flex items-center gap-2">
            AT Clinical Alerts
        </TabsTrigger>
        <TabsTrigger Value="pre-visit" Class="flex items-center gap-2">
            CL Pre-Visit
        </TabsTrigger>
        <TabsTrigger Value="post-visit" Class="flex items-center gap-2">
            ST Post-Visit
        </TabsTrigger>
        <TabsTrigger Value="internal" Class="flex items-center gap-2">
            US Internal
        </TabsTrigger>
    </TabsList>

    <!-- Clinical Alerts Tab -->
    <TabsContent Value="clinical-alerts" Class="space-y-6">
        <Card Class="border-2 border-red-200 bg-red-50">
            <CardContent Class="p-4">
                <div class="flex items-start gap-3">
                    <div class="h-5 w-5 text-red-600 flex-shrink-0 mt-0.5">AT</div>
                    <div>
                        <p class="font-semibold text-red-900 mb-1">Persistent Clinical Alerts</p>
                        <p class="text-sm text-red-800">
                            Display critical precautions and contraindications across all patient interactions to ensure safe treatment.
                        </p>
                    </div>
                </div>
            </CardContent>
        </Card>

        <Card Class="border-2">
            <CardHeader>
                <CardTitle Class="flex items-center gap-2">
                    SH Alert Display Settings
                </CardTitle>
                <CardDescription>
                    Configure when and where clinical alerts are shown
                </CardDescription>
            </CardHeader>
            <CardContent Class="space-y-4">
                <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                    <div class="flex-1">
                        <Label Class="font-semibold">Show Precautions on Patient Chart</Label>
                        <p class="text-sm text-muted-foreground mt-1">
                            Display warning-level precautions in patient header (yellow/orange)
                        </p>
                    </div>
                    <Switch
                        Checked="@settings.ShowPrecautionsOnChart"
                        OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.ShowPrecautionsOnChart), isChecked))"
                    />
                </div>

                <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                    <div class="flex-1">
                        <Label Class="font-semibold">Show Contraindications on Patient Chart</Label>
                        <p class="text-sm text-muted-foreground mt-1">
                            Display critical contraindications in patient header (red)
                        </p>
                    </div>
                    <Switch
                        Checked="@settings.ShowContraindicationsOnChart"
                        OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.ShowContraindicationsOnChart), isChecked))"
                    />
                </div>

                <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                    <div class="flex-1">
                        <Label Class="font-semibold">Color-Coded Alert Badges</Label>
                        <p class="text-sm text-muted-foreground mt-1">
                            Use color coding: Red = Contraindication, Orange = High precaution, Yellow = Precaution
                        </p>
                    </div>
                    <Switch
                        Checked="@settings.AlertColorCoding"
                        OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.AlertColorCoding), isChecked))"
                    />
                </div>

                <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                    <div class="flex-1">
                        <Label Class="font-semibold">Persist Alerts Across Sessions</Label>
                        <p class="text-sm text-muted-foreground mt-1">
                            Keep alerts visible across all screens when viewing patient
                        </p>
                    </div>
                    <Switch
                        Checked="@settings.PersistAlertsAcrossSessions"
                        OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.PersistAlertsAcrossSessions), isChecked))"
                    />
                </div>

                <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                    <div class="flex-1">
                        <Label Class="font-semibold">Require Acknowledgement on First View</Label>
                        <p class="text-sm text-muted-foreground mt-1">
                            Force clinician to acknowledge critical alerts when opening patient chart
                        </p>
                    </div>
                    <Switch
                        Checked="@settings.RequireAcknowledgementOnFirstView"
                        OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.RequireAcknowledgementOnFirstView), isChecked))"
                    />
                </div>
            </CardContent>
        </Card>

        <Card Class="border-2">
            <CardHeader>
                <CardTitle Class="flex items-center gap-2">
                    AT Manage Clinical Alerts
                </CardTitle>
                <CardDescription>
                    Create and manage precautions and contraindications
                </CardDescription>
            </CardHeader>
            <CardContent Class="space-y-3">
                @foreach (var alert in customAlerts)
                {
                    var borderClass = alert.Color == "red" ? "border-red-500 bg-red-50" 
                        : alert.Color == "orange" ? "border-orange-500 bg-orange-50"
                        : "border-yellow-500 bg-yellow-50";
                    
                    var iconColor = alert.Color == "red" ? "text-red-600" 
                        : alert.Color == "orange" ? "text-orange-600"
                        : "text-yellow-600";

                    <div class="p-4 border-2 rounded-lg @borderClass">
                        <div class="flex items-start gap-3">
                            <div class="h-5 w-5 flex-shrink-0 mt-0.5 @iconColor">AT</div>
                            <div class="flex-1">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex-1">
                                        <div class="flex items-center gap-2 mb-1">
                                            <Badge Variant="outline" Class="text-xs">@alert.Type</Badge>
                                            <Badge Variant="outline" Class="@(alert.Active ? "border-green-600 text-green-700" : "border-gray-400 text-gray-600")">
                                                @(alert.Active ? "Active" : "Inactive")
                                            </Badge>
                                        </div>
                                        <p class="text-sm font-semibold">@alert.Text</p>
                                    </div>
                                    <div class="flex gap-2">
                                        <Button Size="sm" Variant="outline">Edit</Button>
                                        <Button Size="sm" Variant="ghost">Delete</Button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <Button Class="w-full mt-4" Variant="outline">
                    AT Add New Clinical Alert
                </Button>
            </CardContent>
        </Card>

        <Card Class="border-2 border-blue-200">
            <CardHeader>
                <CardTitle Class="flex items-center gap-2">
                    CC Alert Display Example
                </CardTitle>
            </CardHeader>
            <CardContent>
                <div class="space-y-3">
                    <p class="text-sm text-muted-foreground mb-3">How alerts appear on patient chart:</p>
                    
                    <div class="p-4 border-2 border-border rounded-lg bg-background">
                        <div class="flex items-center justify-between mb-3">
                            <div class="flex items-center gap-3">
                                <div class="h-12 w-12 rounded-full bg-muted flex items-center justify-center font-semibold">JD</div>
                                <div>
                                    <p class="font-semibold">John Doe</p>
                                    <p class="text-sm text-muted-foreground">DOB: 05/12/1965 • Age 59</p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="flex flex-wrap gap-2">
                            <Badge Class="bg-red-600">AT Contraindication: No cervical manipulation</Badge>
                            <Badge Class="bg-orange-600">AT Fall risk - use gait belt</Badge>
                            <Badge Class="bg-yellow-600">AT Post-surgical - no weight bearing</Badge>
                        </div>
                    </div>
                </div>
            </CardContent>
        </Card>
    </TabsContent>

    <!-- Pre-Visit Prompts Tab -->
    <TabsContent Value="pre-visit" Class="space-y-6">
        <Card Class="border-2 border-blue-200 bg-blue-50">
            <CardContent Class="p-4">
                <div class="flex items-start gap-3">
                    <div class="h-5 w-5 text-blue-600 flex-shrink-0 mt-0.5">CL</div>
                    <div>
                        <p class="font-semibold text-blue-900 mb-1">Pre-Visit Prompts</p>
                        <p class="text-sm text-blue-800">
                            Automatically prompt clinicians to verify critical information before patient arrives or at check-in.
                        </p>
                    </div>
                </div>
            </CardContent>
        </Card>

        <Card Class="border-2">
            <CardHeader>
                <CardTitle Class="flex items-center gap-2">
                    CB Pre-Visit Verification
                </CardTitle>
                <CardDescription>
                    Configure automatic prompts before patient visits
                </CardDescription>
            </CardHeader>
            <CardContent Class="space-y-4">
                <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                    <div class="flex-1">
                        <Label Class="font-semibold">Enable Pre-Visit Prompts</Label>
                        <p class="text-sm text-muted-foreground mt-1">
                            Show verification prompts before scheduled appointments
                        </p>
                    </div>
                    <Switch
                        Checked="@settings.EnablePreVisitPrompts"
                        OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.EnablePreVisitPrompts), isChecked))"
                    />
                </div>

                @if (settings.EnablePreVisitPrompts)
                {
                    <div class="flex items-center justify-between p-4 border-2 border-primary rounded-lg bg-primary/5">
                        <div class="flex-1">
                            <Label Class="font-semibold">Prompt for Insurance Change Confirmation</Label>
                            <p class="text-sm text-muted-foreground mt-1">
                                Ask front desk: "Has patient's insurance changed since last visit?"
                            </p>
                        </div>
                        <Switch
                            Checked="@settings.PromptForInsuranceChange"
                            OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.PromptForInsuranceChange), isChecked))"
                        />
                    </div>

                    <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                        <div class="flex-1">
                            <Label Class="font-semibold">Prompt for Medication Changes</Label>
                            <p class="text-sm text-muted-foreground mt-1">
                                Ask clinician: "Review patient's current medications"
                            </p>
                        </div>
                        <Switch
                            Checked="@settings.PromptForMedicationChange"
                            OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.PromptForMedicationChange), isChecked))"
                        />
                    </div>

                    <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                        <div class="flex-1">
                            <Label Class="font-semibold">Prompt for Authorization Verification</Label>
                            <p class="text-sm text-muted-foreground mt-1">
                                Alert if authorization is expiring or exhausted
                            </p>
                        </div>
                        <Switch
                            Checked="@settings.PromptForAuthVerification"
                            OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.PromptForAuthVerification), isChecked))"
                        />
                    </div>

                    <div class="p-4 border-2 border-border rounded-lg">
                        <Label Class="block mb-2">Prompt Timing</Label>
                        <p class="text-sm text-muted-foreground mb-3">Show prompts when appointment is within:</p>
                        <select
                            @bind="settings.PromptTimingMinutesBefore"
                            class="w-full px-3 py-2 border-2 border-border rounded-lg bg-background"
                        >
                            <option value="5">5 minutes</option>
                            <option value="10">10 minutes</option>
                            <option value="15">15 minutes (Recommended)</option>
                            <option value="30">30 minutes</option>
                            <option value="60">1 hour</option>
                        </select>
                    </div>
                }
            </CardContent>
        </Card>

        <Card Class="border-2 border-green-200">
            <CardHeader>
                <CardTitle Class="flex items-center gap-2">
                    CC Pre-Visit Prompt Example
                </CardTitle>
            </CardHeader>
            <CardContent>
                <div class="p-4 border-2 border-green-500 rounded-lg bg-green-50">
                    <div class="flex gap-3">
                        <div class="h-5 w-5 text-green-600 flex-shrink-0 mt-0.5">CL</div>
                        <div class="flex-1">
                            <p class="font-semibold text-green-900 mb-2">Upcoming Appointment in 15 Minutes</p>
                            <div class="space-y-2 text-sm">
                                <p class="text-green-800"><span class="font-semibold">Patient:</span> Sarah Johnson</p>
                                <p class="text-green-800"><span class="font-semibold">Time:</span> 2:00 PM with Dr. Martinez</p>
                                <div class="mt-3 space-y-2">
                                    <label class="flex items-center gap-2 p-2 bg-white border border-green-300 rounded cursor-pointer">
                                        <input type="checkbox" class="w-4 h-4" />
                                        <span class="text-green-900">Insurance verified - no changes</span>
                                    </label>
                                    <label class="flex items-center gap-2 p-2 bg-white border border-green-300 rounded cursor-pointer">
                                        <input type="checkbox" class="w-4 h-4" />
                                        <span class="text-green-900">Authorization valid (5 visits remaining)</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </CardContent>
        </Card>
    </TabsContent>

    <!-- Post-Visit Patient Messaging Tab -->
    <TabsContent Value="post-visit" Class="space-y-6">
        <Card Class="border-2 border-purple-200 bg-purple-50">
            <CardContent Class="p-4">
                <div class="flex items-start gap-3">
                    <div class="h-5 w-5 text-purple-600 flex-shrink-0 mt-0.5">ST</div>
                    <div>
                        <p class="font-semibold text-purple-900 mb-1">Post-Visit Patient Messaging</p>
                        <p class="text-sm text-purple-800">
                            Automatically collect patient feedback after appointments and route responses to appropriate staff.
                        </p>
                    </div>
                </div>
            </CardContent>
        </Card>

        <Card Class="border-2">
            <CardHeader>
                <CardTitle Class="flex items-center gap-2">
                    MS Post-Visit Feedback Collection
                </CardTitle>
                <CardDescription>
                    Configure "How was your visit?" patient messaging
                </CardDescription>
            </CardHeader>
            <CardContent Class="space-y-4">
                <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                    <div class="flex-1">
                        <Label Class="font-semibold">Enable Post-Visit Feedback Requests</Label>
                        <p class="text-sm text-muted-foreground mt-1">
                            Automatically send "How was your visit?" message after appointments
                        </p>
                    </div>
                    <Switch
                        Checked="@settings.EnablePostVisitFeedback"
                        OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.EnablePostVisitFeedback), isChecked))"
                    />
                </div>

                @if (settings.EnablePostVisitFeedback)
                {
                    <div class="p-4 border-2 border-border rounded-lg">
                        <Label Class="text-sm font-semibold mb-3 block">
                            Send feedback request after: @settings.FeedbackDelayMinutes minutes
                        </Label>
                        <input
                            type="range"
                            min="15"
                            max="240"
                            step="15"
                            @bind="@feedbackDelayValue"
                            class="w-full"
                        />
                        <div class="flex justify-between text-xs text-muted-foreground mt-2">
                            <span>15 min</span>
                            <span>1 hour</span>
                            <span>2 hours</span>
                            <span>4 hours</span>
                        </div>
                    </div>

                    <div class="p-4 border-2 border-border rounded-lg">
                        <Label Class="block mb-2">Feedback Question Type</Label>
                        <div class="space-y-2">
                            <label class="flex items-center gap-3 p-3 border-2 border-primary rounded-lg cursor-pointer bg-primary/5">
                                <input
                                    type="radio"
                                    name="feedbackType"
                                    value="rating"
                                    @onchange="@((ChangeEventArgs e) => UpdateSetting(nameof(settings.FeedbackQuestionType), e.Value?.ToString() ?? ""))"
                                    checked="@(settings.FeedbackQuestionType == "rating")"
                                    class="w-4 h-4 text-primary"
                                />
                                <div class="flex-1">
                                    <p class="font-semibold">Rating Scale (1-5 Stars)</p>
                                    <p class="text-sm text-muted-foreground">Simple star rating with optional comment</p>
                                </div>
                                <Badge Variant="outline" Class="bg-primary text-primary-foreground">
                                    Recommended
                                </Badge>
                            </label>

                            <label class="flex items-center gap-3 p-3 border-2 border-border rounded-lg cursor-pointer hover:bg-muted/50">
                                <input
                                    type="radio"
                                    name="feedbackType"
                                    value="text"
                                    @onchange="@((ChangeEventArgs e) => UpdateSetting(nameof(settings.FeedbackQuestionType), e.Value?.ToString() ?? ""))"
                                    checked="@(settings.FeedbackQuestionType == "text")"
                                    class="w-4 h-4 text-primary"
                                />
                                <div class="flex-1">
                                    <p class="font-semibold">Text Response Only</p>
                                    <p class="text-sm text-muted-foreground">Open-ended text feedback</p>
                                </div>
                            </label>

                            <label class="flex items-center gap-3 p-3 border-2 border-border rounded-lg cursor-pointer hover:bg-muted/50">
                                <input
                                    type="radio"
                                    name="feedbackType"
                                    value="both"
                                    @onchange="@((ChangeEventArgs e) => UpdateSetting(nameof(settings.FeedbackQuestionType), e.Value?.ToString() ?? ""))"
                                    checked="@(settings.FeedbackQuestionType == "both")"
                                    class="w-4 h-4 text-primary"
                                />
                                <div class="flex-1">
                                    <p class="font-semibold">Rating + Required Comment</p>
                                    <p class="text-sm text-muted-foreground">Star rating with mandatory text feedback</p>
                                </div>
                            </label>
                        </div>
                    </div>

                    <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                        <div class="flex-1">
                            <Label Class="font-semibold">Allow Patient Opt-Out</Label>
                            <p class="text-sm text-muted-foreground mt-1">
                                Include "Don't ask again" option in feedback request
                            </p>
                        </div>
                        <Switch
                            Checked="@settings.AllowPatientOptOut"
                            OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.AllowPatientOptOut), isChecked))"
                        />
                    </div>
                }
            </CardContent>
        </Card>

        <Card Class="border-2">
            <CardHeader>
                <CardTitle Class="flex items-center gap-2">
                    SN Feedback Routing
                </CardTitle>
                <CardDescription>
                    Configure who receives patient feedback notifications
                </CardDescription>
            </CardHeader>
            <CardContent Class="space-y-4">
                <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                    <div class="flex-1">
                        <Label Class="font-semibold">Route to Practice Owner</Label>
                        <p class="text-sm text-muted-foreground mt-1">Send all patient feedback to practice owner</p>
                    </div>
                    <Switch
                        Checked="@settings.RouteToOwner"
                        OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.RouteToOwner), isChecked))"
                    />
                </div>

                <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                    <div class="flex-1">
                        <Label Class="font-semibold">Route to Practice Manager</Label>
                        <p class="text-sm text-muted-foreground mt-1">Send all patient feedback to practice manager</p>
                    </div>
                    <Switch
                        Checked="@settings.RouteToManager"
                        OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.RouteToManager), isChecked))"
                    />
                </div>

                <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                    <div class="flex-1">
                        <Label Class="font-semibold">Route to Treating Clinician</Label>
                        <p class="text-sm text-muted-foreground mt-1">Send feedback to the clinician who performed the visit</p>
                    </div>
                    <Switch
                        Checked="@settings.RouteToTreatingClinician"
                        OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.RouteToTreatingClinician), isChecked))"
                    />
                </div>

                <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                    <div class="flex-1">
                        <Label Class="font-semibold">Route to Front Desk</Label>
                        <p class="text-sm text-muted-foreground mt-1">Send feedback to front desk staff</p>
                    </div>
                    <Switch
                        Checked="@settings.RouteToFrontDesk"
                        OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.RouteToFrontDesk), isChecked))"
                    />
                </div>

                <div class="p-4 border-2 border-orange-200 bg-orange-50 rounded-lg">
                    <div class="flex gap-2">
                        <div class="h-5 w-5 text-orange-600 flex-shrink-0 mt-0.5">!</div>
                        <div class="flex-1">
                            <p class="font-semibold text-orange-900 mb-2">Negative Feedback Alerts</p>
                            
                            <div class="mb-3">
                                <label class="flex items-center gap-2">
                                    <Switch
                                        Checked="@settings.AlertOnNegativeFeedback"
                                        OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.AlertOnNegativeFeedback), isChecked))"
                                    />
                                    <span class="text-sm text-orange-900 font-semibold">Send urgent alert for negative feedback</span>
                                </label>
                            </div>

                            @if (settings.AlertOnNegativeFeedback)
                            {
                                <div class="mt-3">
                                    <Label Class="block mb-2 text-orange-900">Negative Feedback Threshold</Label>
                                    <select
                                        @bind="settings.NegativeFeedbackThreshold"
                                        class="w-full px-3 py-2 border-2 border-orange-300 rounded-lg bg-white"
                                    >
                                        <option value="1">1 star or lower</option>
                                        <option value="2">2 stars or lower</option>
                                        <option value="3">3 stars or lower (Recommended)</option>
                                        <option value="4">4 stars or lower</option>
                                    </select>
                                    <p class="text-xs text-orange-800 mt-2">
                                        Immediately notify owner and manager when rating is at or below this threshold
                                    </p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </CardContent>
        </Card>

        <Card Class="border-2 border-purple-200">
            <CardHeader>
                <CardTitle Class="flex items-center gap-2">
                    ST Patient Feedback Example
                </CardTitle>
            </CardHeader>
            <CardContent>
                <div class="p-4 border-2 border-purple-300 rounded-lg bg-purple-50">
                    <div class="space-y-3">
                        <p class="font-semibold text-purple-900">How was your visit today?</p>
                        <p class="text-sm text-purple-800">We'd love to hear about your experience with Dr. Martinez</p>
                        
                        <div class="flex gap-2 justify-center py-3">
                            @for (int i = 1; i <= 5; i++)
                            {
                                var starIndex = i;
                                var isFilled = starIndex <= 4;
                                <div class="h-8 w-8 cursor-pointer @(isFilled ? "fill-yellow-400 text-yellow-400" : "text-gray-300")">ST</div>
                            }
                        </div>

                        <div class="mt-3">
                            <textarea
                                placeholder="Tell us more about your visit... (optional)"
                                class="w-full p-3 border-2 border-purple-300 rounded-lg bg-white text-sm"
                                rows="3"
                            ></textarea>
                        </div>

                        <div class="flex gap-2 mt-3">
                            <Button Class="flex-1 bg-purple-600 hover:bg-purple-700">Submit Feedback</Button>
                        </div>

                        <button class="text-xs text-purple-700 underline w-full text-center mt-2">Don't ask me again</button>
                    </div>
                </div>
            </CardContent>
        </Card>
    </TabsContent>

    <!-- Internal Messaging Tab -->
    <TabsContent Value="internal" Class="space-y-6">
        <Card Class="border-2 border-green-200 bg-green-50">
            <CardContent Class="p-4">
                <div class="flex items-start gap-3">
                    <div class="h-5 w-5 text-green-600 flex-shrink-0 mt-0.5">US</div>
                    <div>
                        <p class="font-semibold text-green-900 mb-1">Internal Staff Messaging</p>
                        <p class="text-sm text-green-800">
                            Configure notifications for co-treatment assignments, co-sign requests, and other internal workflows.
                        </p>
                    </div>
                </div>
            </CardContent>
        </Card>

        <Card Class="border-2">
            <CardHeader>
                <CardTitle Class="flex items-center gap-2">
                    US Co-Treatment & Assignment Notifications
                </CardTitle>
                <CardDescription>
                    Alert clinicians when assigned to co-treat or assist
                </CardDescription>
            </CardHeader>
            <CardContent Class="space-y-4">
                <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                    <div class="flex-1">
                        <Label Class="font-semibold">Enable Co-Treatment Notifications</Label>
                        <p class="text-sm text-muted-foreground mt-1">
                            Notify clinician when assigned as co-treating therapist
                        </p>
                    </div>
                    <Switch
                        Checked="@settings.EnableCoTreatmentNotifications"
                        OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.EnableCoTreatmentNotifications), isChecked))"
                    />
                </div>

                @if (settings.EnableCoTreatmentNotifications)
                {
                    <div class="p-4 border-2 border-blue-200 bg-blue-50 rounded-lg">
                        <div class="flex gap-2">
                            <div class="h-5 w-5 text-blue-600 flex-shrink-0 mt-0.5">UC</div>
