                    />
                </div>

                <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                    <div class="flex items-center gap-3 flex-1">
                        <div class="h-5 w-5 text-primary">ML</div>
                        <div>
                            <Label Class="font-semibold">Email Notifications</Label>
                            <p class="text-sm text-muted-foreground mt-1">Send notifications via email</p>
                        </div>
                    </div>
                    <Switch
                        Checked="@settings.EnableEmailNotifications"
                        OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.EnableEmailNotifications), isChecked))"
                    />
                </div>

                <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                    <div class="flex items-center gap-3 flex-1">
                        <div class="h-5 w-5 text-primary">SM</div>
                        <div>
                            <Label Class="font-semibold">SMS Notifications</Label>
                            <p class="text-sm text-muted-foreground mt-1">Text message alerts for urgent notifications</p>
                        </div>
