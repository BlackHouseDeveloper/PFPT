        <Card Class="border-2">
            <CardHeader>
                <CardTitle Class="flex items-center gap-2">
                    FT Co-Sign Request Workflow
                </CardTitle>
                <CardDescription>
                    Manage co-signature notifications and escalations
                </CardDescription>
            </CardHeader>
            <CardContent Class="space-y-4">
                <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                    <div class="flex-1">
                        <Label Class="font-semibold">Enable Co-Sign Request Notifications</Label>
                        <p class="text-sm text-muted-foreground mt-1">
                            Notify supervising PT when PTA submits note for co-signature
                        </p>
                    </div>
                    <Switch
                        Checked="@settings.EnableCoSignRequests"
                        OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.EnableCoSignRequests), isChecked))"
                    />
                </div>

                @if (settings.EnableCoSignRequests)
                {
                    <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                        <div class="flex-1">
                            <Label Class="font-semibold">Notify on Co-Sign Submission</Label>
                            <p class="text-sm text-muted-foreground mt-1">
                                Send immediate notification when note is submitted for review
                            </p>
                        </div>
                        <Switch
                            Checked="@settings.NotifyOnCoSignSubmission"
                            OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.NotifyOnCoSignSubmission), isChecked))"
                        />
                    </div>

                    <div class="p-4 border-2 border-border rounded-lg">
                        <Label Class="block mb-2">Send Reminder After</Label>
                        <select
                            @bind="settings.ReminderAfterHours"
                            class="w-full px-3 py-2 border-2 border-border rounded-lg bg-background"
