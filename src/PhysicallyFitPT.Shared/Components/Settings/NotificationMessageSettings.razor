                        </p>
                    </div>

                    <div class="p-4 border-2 border-border rounded-lg">
                        <Label Class="block mb-2">Escalate to Manager After</Label>
                        <select
                            @bind="settings.EscalateAfterDays"
                            class="w-full px-3 py-2 border-2 border-border rounded-lg bg-background"
                        >
                            <option value="1">1 day</option>
                            <option value="2">2 days</option>
                            <option value="3">3 days (Recommended)</option>
                            <option value="5">5 days</option>
                            <option value="7">7 days</option>
                        </select>
                        <p class="text-xs text-muted-foreground mt-2">
                            Alert practice manager if note remains unsigned after this period
                        </p>
                    </div>
                }
            </CardContent>
        </Card>

        <Card Class="border-2">
            <CardHeader>
                <CardTitle Class="flex items-center gap-2">
                    BL Other Internal Alerts
                </CardTitle>
                <CardDescription>
                    Additional staff notification settings
                </CardDescription>
            </CardHeader>
            <CardContent Class="space-y-4">
                <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                    <div class="flex-1">
                        <Label Class="font-semibold">Authorization Expiration Alerts</Label>
                        <p class="text-sm text-muted-foreground mt-1">
                            Notify when patient authorization is running low or expired
                        </p>
                    </div>
                    <Switch
