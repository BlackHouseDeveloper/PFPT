            </CardContent>
        </Card>

        <Card Class="border-2">
            <CardHeader>
                <CardTitle Class="flex items-center gap-2">
                    CL General Notifications
                </CardTitle>
                <CardDescription>
                    Appointment reminders and other general alerts
                </CardDescription>
            </CardHeader>
            <CardContent Class="space-y-4">
                <div class="flex items-center justify-between p-4 border-2 border-border rounded-lg">
                    <div class="flex-1">
                        <Label Class="font-semibold">Appointment Reminders</Label>
                        <p class="text-sm text-muted-foreground mt-1">
                            Send automatic appointment reminders to patients
                        </p>
                    </div>
                    <Switch
                        Checked="@settings.EnableAppointmentReminders"
                        OnCheckedChange="@((bool isChecked) => UpdateSetting(nameof(settings.EnableAppointmentReminders), isChecked))"
                    />
                </div>

                @if (settings.EnableAppointmentReminders)
                {
                    <div class="p-4 border-2 border-border rounded-lg bg-muted/50">
                        <Label Class="block mb-2">Send Reminder</Label>
                        <select
                            @bind="settings.ReminderHoursBefore"
                            class="w-full px-3 py-2 border-2 border-border rounded-lg bg-background"
                        >
                            <option value="1">1 hour before</option>
                            <option value="2">2 hours before</option>
                            <option value="4">4 hours before</option>
                            <option value="24">24 hours before (Recommended)</option>
                            <option value="48">48 hours before</option>
                        </select>
                    </div>
                }
            </CardContent>
        </Card>
    </TabsContent>
</Tabs>

@code {
    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public bool HasUnsavedChanges { get; set; }

    [Parameter]
    public EventCallback HasUnsavedChangesChanged { get; set; }

    private Settings settings = new();
    private int feedbackDelayValue;

    private List<AlertItem> customAlerts = new()
    {
        new AlertItem { Id = 1, Type = "Precaution", Text = "Post-surgical patient - no weight bearing left leg", Color = "yellow", Active = true },
        new AlertItem { Id = 2, Type = "Contraindication", Text = "Absolute contraindication: cervical manipulation", Color = "red", Active = true },
        new AlertItem { Id = 3, Type = "Precaution", Text = "Fall risk - use gait belt for all ambulation", Color = "orange", Active = true }
    };

    protected override void OnInitialized()
    {
        feedbackDelayValue = settings.FeedbackDelayMinutes;
    }

    private void UpdateSetting(string key, object value)
    {
        var property = settings.GetType().GetProperty(key);
        if (property != null)
        {
            if (property.PropertyType == typeof(int) && value is string strValue)
            {
                property.SetValue(settings, int.Parse(strValue));
            }
            else
            {
                property.SetValue(settings, value);
            }
        }
        HasUnsavedChanges = true;
        HasUnsavedChangesChanged.InvokeAsync(true);
    }

    private class Settings
    {
        // Persistent Clinical Alerts
        public bool ShowPrecautionsOnChart { get; set; } = true;
        public bool ShowContraindicationsOnChart { get; set; } = true;
        public bool AlertColorCoding { get; set; } = true;
        public bool PersistAlertsAcrossSessions { get; set; } = true;
        public bool RequireAcknowledgementOnFirstView { get; set; } = true;
        
        // Pre-Visit Prompts
        public bool EnablePreVisitPrompts { get; set; } = true;
        public bool PromptForInsuranceChange { get; set; } = true;
        public bool PromptForMedicationChange { get; set; } = false;
        public bool PromptForAuthVerification { get; set; } = true;
        public int PromptTimingMinutesBefore { get; set; } = 15;
        
        // Post-Visit Patient Messaging
        public bool EnablePostVisitFeedback { get; set; } = true;
        public int FeedbackDelayMinutes { get; set; } = 60;
        public bool AllowPatientOptOut { get; set; } = true;
        public string FeedbackQuestionType { get; set; } = "rating";
        
        // Feedback Routing
        public bool RouteToOwner { get; set; } = true;
        public bool RouteToManager { get; set; } = true;
        public bool RouteToTreatingClinician { get; set; } = true;
        public bool RouteToFrontDesk { get; set; } = false;
        public bool AlertOnNegativeFeedback { get; set; } = true;
        public int NegativeFeedbackThreshold { get; set; } = 3;
        
        // Internal Messaging
        public bool EnableCoTreatmentNotifications { get; set; } = true;
        public bool EnableCoSignRequests { get; set; } = true;
        public bool EnableAuthExpirationAlerts { get; set; } = true;
        public bool EnablePOCReminderAlerts { get; set; } = true;
        
        // Co-Sign Workflow
        public bool NotifyOnCoSignSubmission { get; set; } = true;
        public int ReminderAfterHours { get; set; } = 24;
        public int EscalateAfterDays { get; set; } = 3;
        
        // Delivery Methods
        public bool EnablePushNotifications { get; set; } = true;
        public bool EnableEmailNotifications { get; set; } = true;
        public bool EnableSMSNotifications { get; set; } = false;
        
        // General
        public bool EnableAppointmentReminders { get; set; } = true;
        public int ReminderHoursBefore { get; set; } = 24;
    }

    private class AlertItem
    {
        public int Id { get; set; }
        public string Type { get; set; } = "";
        public string Text { get; set; } = "";
        public string Color { get; set; } = "";
        public bool Active { get; set; }
    }
}
