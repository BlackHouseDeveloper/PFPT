    private void UpdateSetting(string key, object value)
    {
        var property = settings.GetType().GetProperty(key);
        if (property != null)
        {
            property.SetValue(settings, value);
        }
        HasUnsavedChanges = true;
        HasUnsavedChangesChanged.InvokeAsync(true);
    }

    private void SetEditingPrompt(string? key)
    {
        editingPrompt = key;
    }

    private string GetPromptLabel(string key) => key switch
    {
        "assessment" => "Assessment",
        "plan" => "Plan",
        "goals" => "SMART Goals",
        "discharge" => "Discharge Summary",
        "followUp" => "Follow-Up Instructions",
        _ => "Unknown"
    };

    private List<string> GetPromptVariables(string promptKey) => promptKey switch
    {
        "assessment" => new() { "Variables: {chiefComplaint}", "{subjective}", "{objective}", "{outcomeScores}" },
        "plan" => new() { "Variables: {assessment}", "{icdCodes}", "{limitations}", "{patientGoals}" },
        "goals" => new() { "Variables: {outcomeMeasureName}", "{currentScore}", "{responses}", "{limitations}" },
        "discharge" => new() { "Variables: {evalDate}", "{visitCount}", "{initialScores}", "{finalScores}", "{interventions}" },
        "followUp" => new() { "Variables: {diagnosis}", "{improvements}", "{limitations}", "{hep}" },
        _ => new()
    };

    private class Settings
    {
        public bool AutoSelectByBodyPart { get; set; } = true;
        public bool AllowDeletionOfNonTestedMeasures { get; set; } = true;
        public bool RequireOutcomeMeasureCompletion { get; set; } = false;
        public bool ShowOutcomeTrends { get; set; } = true;
        public bool GenerateGoalsFromScores { get; set; } = true;
        public bool GenerateGoalsFromAnswers { get; set; } = true;
        public bool AllowMultiSelectGoals { get; set; } = true;
        public bool RequireManualGoalReview { get; set; } = true;
        public bool GoalRegenerationAllowed { get; set; } = false;
        public bool EnableAIAssessment { get; set; } = true;
        public bool EnableAIPlan { get; set; } = true;
        public bool EnableAIGoals { get; set; } = true;
        public bool EnableAIDischargeSummary { get; set; } = true;
        public bool EnableAIFollowUpInstructions { get; set; } = true;
        public bool EnableAISubjectiveSummary { get; set; } = false;
        public bool AutoApplyAISuggestions { get; set; } = false;
        public bool RequireAIReview { get; set; } = true;
        public int AIConfidenceThreshold { get; set; } = 70;
        public bool TrackOutcomeMeasures { get; set; } = true;
        public bool SuggestInterventions { get; set; } = true;
    }

    private class OutcomeBodyPart
    {
        public string BodyPart { get; set; } = string.Empty;
        public List<string> Measures { get; set; } = new();
    }
