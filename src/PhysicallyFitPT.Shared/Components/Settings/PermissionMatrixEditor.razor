@namespace PhysicallyFitPT.Shared.Components.Settings

<div class="space-y-6">
    <!-- Help Banner -->
    <Card Class="border-2 border-purple-200 bg-purple-50">
        <CardContent Class="p-4">
            <div class="flex items-start gap-3">
                <div class="h-5 w-5 text-purple-600 flex-shrink-0 mt-0.5">IN</div>
                <div class="flex-1">
                    <p class="font-semibold text-purple-900 mb-2">How to Use the Permission Matrix</p>
                    <ul class="text-sm text-purple-800 space-y-1 list-disc list-inside">
                        <li><strong>None:</strong> No access to this feature</li>
                        <li><strong>View:</strong> Read-only access (can see but not modify)</li>
                        <li><strong>Edit:</strong> Can create and modify (standard user access)</li>
                        <li><strong>Full:</strong> Complete control including delete and admin actions</li>
                        <li>LK <strong>Locked permissions</strong> are system-required and cannot be changed</li>
                        <li>AT <strong>Recommended permissions</strong> are suggested for optimal workflow</li>
                    </ul>
                </div>
            </div>
        </CardContent>
    </Card>

    <!-- Role Selector -->
    <Card Class="border-2">
        <CardHeader>
            <CardTitle Class="flex items-center gap-2">
                SH Select Role to Configure
            </CardTitle>
            <CardDescription>
                Choose a role to view and edit its permissions
            </CardDescription>
        </CardHeader>
        <CardContent>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3">
                @foreach (var role in RolesList)
                {
                    <button
                        @onclick="@(() => SelectRole(role.Id))"
                        class="@(
                            selectedRole == role.Id
                                ? "p-4 border-2 border-primary bg-primary/5 rounded-lg text-left transition-all"
                                : "p-4 border-2 border-border hover:border-primary/50 rounded-lg text-left transition-all"
                        )"
                    >
                        <div class="flex items-center gap-2 mb-2">
                            <div class="@($"w-3 h-3 rounded-full {role.ColorClass}")"></div>
                            <p class="font-semibold text-sm">@role.Label</p>
                        </div>
                        <p class="text-xs text-muted-foreground">@role.Description</p>
                    </button>
                }
            </div>
        </CardContent>
    </Card>

    <!-- Clone Permissions -->
    <Card Class="border-2 border-blue-200 bg-blue-50">
        <CardContent Class="p-4">
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3">
                <div class="h-5 w-5 text-blue-600 flex-shrink-0">CP</div>
                <div class="flex-1">
                    <Label Class="font-semibold text-blue-900">Clone Permissions</Label>
                    <p class="text-sm text-blue-700 mt-1">
                        Copy permissions from another role to @(GetCurrentRoleLabel() ?? "selected role")
                    </p>
                </div>
                <div class="flex gap-2 w-full sm:w-auto">
                    <select
                        @bind="cloneFromRole"
                        class="px-3 py-2 border-2 border-blue-300 rounded-lg bg-white text-sm"
                    >
                        <option value="">Select role...</option>
                        @foreach (var role in RolesList.Where(r => r.Id != selectedRole))
                        {
                            <option value="@role.Id">@role.Label</option>
                        }
                    </select>
                    <Button
                        OnClick="@HandleClonePermissions"
                        Disabled="@(string.IsNullOrEmpty(cloneFromRole))"
                        Class="bg-blue-600 hover:bg-blue-700"
                    >
                        Clone
                    </Button>
                </div>
            </div>
        </CardContent>
    </Card>

    <!-- Permission Categories -->
    @foreach (var category in PermissionCategories)
    {
        <Card Class="border-2">
            <CardHeader>
                <CardTitle Class="flex items-center gap-2">
                    @GetCategoryIcon(category.Id)
                    @category.Label
                </CardTitle>
            </CardHeader>
            <CardContent>
                <div class="space-y-3">
                    @foreach (var permission in category.Permissions)
                    {
                        var currentLevel = permissions.ContainsKey(selectedRole) && permissions[selectedRole].ContainsKey(permission.Id)
                            ? permissions[selectedRole][permission.Id]
                            : "none";
                        var isLocked = permission.SystemLocked && (permission.RequiredRoles?.Contains(selectedRole) ?? false);
                        var isRequired = permission.RequiredRoles?.Contains(selectedRole) ?? false;

                        <div class="@(isLocked ? "p-4 border-2 rounded-lg bg-orange-50 border-orange-200" : "p-4 border-2 rounded-lg border-border")">
                            <div class="flex items-start justify-between gap-4">
                                <div class="flex-1">
                                    <div class="flex items-center gap-2 mb-1">
                                        <Label Class="font-semibold">@permission.Label</Label>
                                        @if (isLocked)
                                        {
                                            <div title="System-required permission - cannot be disabled" class="h-4 w-4 text-orange-600">LK</div>
                                        }
                                        @if (isRequired && !isLocked)
                                        {
                                            <div title="Recommended for this role" class="h-4 w-4 text-yellow-600">AT</div>
                                        }
                                        <div title="@permission.Description" class="h-4 w-4 text-muted-foreground">IN</div>
                                    </div>
                                    <p class="text-sm text-muted-foreground">
                                        @permission.Description
                                    </p>
                                </div>

                                <!-- Permission Level Controls -->
                                <div class="flex items-center gap-2">
                                    @foreach (var level in permission.Levels)
                                    {
                                        var levelLabel = level == "none" ? "None" :
                                                       level == "view" ? "View" :
                                                       level == "edit" ? "Edit" : "Full";
                                        var isSelected = currentLevel == level;
                                        var buttonClass = isSelected
                                            ? "px-3 py-1.5 rounded-md text-xs font-medium transition-all bg-primary text-primary-foreground"
                                            : isLocked
                                            ? "px-3 py-1.5 rounded-md text-xs font-medium transition-all bg-gray-200 text-gray-400 cursor-not-allowed"
                                            : "px-3 py-1.5 rounded-md text-xs font-medium transition-all bg-muted hover:bg-muted/80";

                                        <button
                                            @onclick="@(() => UpdatePermission(selectedRole, permission.Id, level))"
                                            disabled="@isLocked"
                                            class="@buttonClass"
                                            title="@(level == "none" ? "No access" : level == "view" ? "Read-only access" : level == "edit" ? "Create and modify" : "Complete control")"
                                        >
                                            @levelLabel
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </CardContent>
        </Card>
    }

    <!-- Permission Summary -->
    <Card Class="border-2 border-green-200 bg-green-50">
        <CardHeader>
            <CardTitle Class="flex items-center gap-2 text-green-900">
                CC Permission Summary for @(GetCurrentRoleLabel() ?? "")
            </CardTitle>
        </CardHeader>
        <CardContent>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="text-center">
                    <p class="text-2xl font-bold text-green-900">
                        @GetPermissionCount("full")
                    </p>
                    <p class="text-sm text-green-700">Full Access</p>
                </div>
                <div class="text-center">
                    <p class="text-2xl font-bold text-blue-900">
                        @GetPermissionCount("edit")
                    </p>
                    <p class="text-sm text-blue-700">Edit Access</p>
                </div>
                <div class="text-center">
                    <p class="text-2xl font-bold text-gray-900">
                        @GetPermissionCount("view")
                    </p>
                    <p class="text-sm text-gray-700">View Only</p>
                </div>
                <div class="text-center">
                    <p class="text-2xl font-bold text-gray-500">
                        @GetPermissionCount("none")
                    </p>
                    <p class="text-sm text-gray-600">No Access</p>
                </div>
            </div>
        </CardContent>
    </Card>
</div>

