    private void UpdatePermission(string role, string permissionId, string level)
    {
        if (!permissions.ContainsKey(role))
            permissions[role] = new();
        
        permissions[role][permissionId] = level;
        HasUnsavedChanges = true;
        HasUnsavedChangesChanged.InvokeAsync(true);
    }

    private void HandleClonePermissions()
    {
        if (string.IsNullOrEmpty(cloneFromRole) || !permissions.ContainsKey(cloneFromRole))
            return;
        
        permissions[selectedRole] = new(permissions[cloneFromRole]);
        HasUnsavedChanges = true;
        HasUnsavedChangesChanged.InvokeAsync(true);
        cloneFromRole = "";
    }

    private string? GetCurrentRoleLabel()
    {
        return RolesList.FirstOrDefault(r => r.Id == selectedRole)?.Label;
    }

    private string GetCategoryIcon(string categoryId)
    {
        return categoryId switch
        {
            "clinical-documentation" => "FT",
            "scheduling" => "CA",
            "billing-coding" => "DS",
            "messaging" => "MS",
            "reporting" => "BC",
            "admin-settings" => "ST",
            _ => "XX"
        };
    }

    private int GetPermissionCount(string level)
    {
        if (!permissions.ContainsKey(selectedRole))
            return 0;
        
        return permissions[selectedRole].Values.Count(v => v == level);
    }
}
