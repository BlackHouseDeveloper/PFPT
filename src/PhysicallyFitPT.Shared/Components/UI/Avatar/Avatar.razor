@* Avatar root container - manages image loading state *@

<div class="@CombinedClass"
     @attributes="AdditionalAttributes">
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    internal bool ImageLoaded { get; set; } = false;
    internal bool ImageFailed { get; set; } = false;

    private string CombinedClass => 
        $"relative flex size-10 shrink-0 overflow-hidden rounded-full {Class}".Trim();

    internal void OnImageLoaded()
    {
        ImageLoaded = true;
        ImageFailed = false;
        StateHasChanged();
    }

    internal void OnImageError()
    {
        ImageLoaded = false;
        ImageFailed = true;
        StateHasChanged();
    }
}
