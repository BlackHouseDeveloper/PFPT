@namespace PhysicallyFitPT.Shared.Components.UI

<button type="button"
        role="switch"
        aria-checked="@IsChecked"
        aria-label="@AriaLabel"
        disabled="@Disabled"
        class="@GetSwitchClass()"
        @onclick="ToggleSwitch"
        @attributes="AdditionalAttributes">
    <span class="switch-thumb" data-state="@(IsChecked ? "checked" : "unchecked")"></span>
</button>

@code {
    [Parameter]
    public bool IsChecked { get; set; } = false;

    [Parameter]
    public EventCallback<bool> OnChange { get; set; }

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; } = "Toggle switch";

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string GetSwitchClass()
    {
        var baseClass = "switch peer";
        var stateClass = IsChecked ? "switch-checked" : "switch-unchecked";
        var disabledClass = Disabled ? "switch-disabled" : "";
        var customClass = Class ?? "";
        
        return $"{baseClass} {stateClass} {disabledClass} {customClass}".Trim();
    }

    private async Task ToggleSwitch()
    {
        if (!Disabled)
        {
            IsChecked = !IsChecked;
            await OnChange.InvokeAsync(IsChecked);
        }
    }
}
