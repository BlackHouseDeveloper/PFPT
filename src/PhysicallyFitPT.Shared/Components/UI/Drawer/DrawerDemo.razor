@* Demo page showing Drawer usage examples *@

<div class="space-y-8">
    <!-- Bottom drawer (default) -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Bottom Drawer (Default)</h3>
        <Card Class="max-w-2xl">
            <CardContent>
                <Drawer @bind-Open="bottomDrawerOpen" Direction="bottom">
                    <DrawerTrigger>
                        <Button>Open Bottom Drawer</Button>
                    </DrawerTrigger>
                    <DrawerHeader>
                        <DrawerTitle>Quick Actions</DrawerTitle>
                        <DrawerDescription>Select an action to perform</DrawerDescription>
                    </DrawerHeader>
                    <div class="drawer-body">
                        <div class="action-list">
                            <button class="action-item" @onclick="() => HandleAction("New Note")">
                                <span>New Note</span>
                            </button>
                            <button class="action-item" @onclick="() => HandleAction("Schedule Appointment")">
                                <span>Schedule Appointment</span>
                            </button>
                            <button class="action-item" @onclick="() => HandleAction("View Calendar")">
                                <span>View Calendar</span>
                            </button>
                        </div>
                    </div>
                    <DrawerFooter>
                        <Button OnClick="() => bottomDrawerOpen = false">Close</Button>
                    </DrawerFooter>
                </Drawer>
            </CardContent>
        </Card>
    </div>

    <!-- Right drawer -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Right Drawer (Side Panel)</h3>
        <Card Class="max-w-2xl">
            <CardContent>
                <Drawer @bind-Open="rightDrawerOpen" Direction="right">
                    <DrawerTrigger>
                        <Button>Open Right Drawer</Button>
                    </DrawerTrigger>
                    <DrawerHeader>
                        <DrawerTitle>Patient Details</DrawerTitle>
                        <DrawerDescription>Quick view of patient information</DrawerDescription>
                    </DrawerHeader>
                    <div class="drawer-body p-4">
                        <div class="space-y-4">
                            <div>
                                <label class="text-sm font-medium text-gray-700 block mb-1">Name</label>
                                <p class="text-sm text-gray-900">Jane Smith</p>
                            </div>
                            <div>
                                <label class="text-sm font-medium text-gray-700 block mb-1">Date of Birth</label>
                                <p class="text-sm text-gray-900">March 15, 1985</p>
                            </div>
                            <div>
                                <label class="text-sm font-medium text-gray-700 block mb-1">Phone</label>
                                <p class="text-sm text-gray-900">(555) 123-4567</p>
                            </div>
                            <div>
                                <label class="text-sm font-medium text-gray-700 block mb-1">Last Visit</label>
                                <p class="text-sm text-gray-900">@DateTime.Today.AddDays(-7).ToString("MMMM d, yyyy")</p>
                            </div>
                        </div>
                    </div>
                    <DrawerFooter>
                        <Button OnClick="() => rightDrawerOpen = false">Close</Button>
                    </DrawerFooter>
                </Drawer>
            </CardContent>
        </Card>
    </div>

    <!-- Left drawer -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Left Drawer (Navigation)</h3>
        <Card Class="max-w-2xl">
            <CardContent>
                <Drawer @bind-Open="leftDrawerOpen" Direction="left">
                    <DrawerTrigger>
                        <Button>Open Left Drawer</Button>
                    </DrawerTrigger>
                    <DrawerHeader>
                        <DrawerTitle>Navigation</DrawerTitle>
                        <DrawerDescription>Navigate to different sections</DrawerDescription>
                    </DrawerHeader>
                    <div class="drawer-body p-4">
                        <nav class="space-y-2">
                            <button class="nav-item" @onclick="() => HandleNav("Dashboard")">Dashboard</button>
                            <button class="nav-item" @onclick="() => HandleNav("Patients")">Patients</button>
                            <button class="nav-item" @onclick="() => HandleNav("Appointments")">Appointments</button>
                            <button class="nav-item" @onclick="() => HandleNav("Notes")">Notes</button>
                            <button class="nav-item" @onclick="() => HandleNav("Reports")">Reports</button>
                        </nav>
                    </div>
                    <DrawerFooter>
                        <Button OnClick="() => leftDrawerOpen = false">Close</Button>
                    </DrawerFooter>
                </Drawer>
            </CardContent>
        </Card>
    </div>

    <!-- Clinical use case: Exercise instructions -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Clinical Use Case: Exercise Instructions</h3>
        <Card Class="max-w-2xl">
            <CardHeader>
                <CardTitle>Home Exercise Program</CardTitle>
                <CardDescription>View detailed instructions for prescribed exercises</CardDescription>
            </CardHeader>
            <CardContent>
                <Drawer @bind-Open="exerciseDrawerOpen" Direction="bottom">
                    <DrawerTrigger>
                        <Button>View Exercise: Squat to Chair</Button>
                    </DrawerTrigger>
                    <DrawerHeader>
                        <DrawerTitle>Squat to Chair</DrawerTitle>
                        <DrawerDescription>Strengthening exercise for lower extremities</DrawerDescription>
                    </DrawerHeader>
                    <div class="drawer-body p-4">
                        <div class="space-y-4">
                            <div class="bg-gray-50 rounded-lg p-4">
                                <h4 class="text-sm font-semibold text-gray-900 mb-2">Instructions</h4>
                                <ol class="text-sm text-gray-600 space-y-2 list-decimal list-inside">
                                    <li>Stand in front of a chair with feet shoulder-width apart</li>
                                    <li>Slowly lower yourself as if sitting down, stopping just before touching the chair</li>
                                    <li>Hold for 2 seconds</li>
                                    <li>Push through your heels to return to standing</li>
                                    <li>Repeat 12 times</li>
                                </ol>
                            </div>
                            <div>
                                <h4 class="text-sm font-semibold text-gray-900 mb-2">Dosage</h4>
                                <p class="text-sm text-gray-600">3 sets of 12 repetitions, 2x daily</p>
                            </div>
                            <div>
                                <h4 class="text-sm font-semibold text-gray-900 mb-2">Precautions</h4>
                                <p class="text-sm text-gray-600">Stop if you experience sharp pain. Mild muscle fatigue is normal.</p>
                            </div>
                        </div>
                    </div>
                    <DrawerFooter>
                        <Button Variant="outline" OnClick="() => exerciseDrawerOpen = false">Close</Button>
                        <Button OnClick="() => HandleMarkComplete()">Mark Complete</Button>
                    </DrawerFooter>
                </Drawer>
            </CardContent>
        </Card>
    </div>

    <!-- Status message -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="bg-green-50 border border-green-200 rounded-lg p-4">
            <p class="text-sm text-green-800">
                <span class="font-semibold">Action:</span> @statusMessage
            </p>
        </div>
    }
</div>

@code {
    private bool bottomDrawerOpen;
    private bool rightDrawerOpen;
    private bool leftDrawerOpen;
    private bool exerciseDrawerOpen;
    private string? statusMessage;

    private void HandleAction(string action)
    {
        statusMessage = $"{action} selected";
        bottomDrawerOpen = false;
    }

    private void HandleNav(string page)
    {
        statusMessage = $"Navigated to {page}";
        leftDrawerOpen = false;
    }

    private void HandleMarkComplete()
    {
        statusMessage = "Exercise marked complete";
        exerciseDrawerOpen = false;
    }
}

<style>
    .space-y-8 > * + * {
        margin-top: 2rem;
    }

    .space-y-4 > * + * {
        margin-top: 1rem;
    }

    .space-y-2 > * + * {
        margin-top: 0.5rem;
    }

    .text-sm {
        font-size: 0.875rem;
        line-height: 1.25rem;
    }

    .font-semibold {
        font-weight: 600;
    }

    .font-medium {
        font-weight: 500;
    }

    .text-gray-700 {
        color: #374151;
    }

    .text-gray-600 {
        color: #4b5563;
    }

    .text-gray-900 {
        color: #111827;
    }

    .mb-3 {
        margin-bottom: 0.75rem;
    }

    .mb-2 {
        margin-bottom: 0.5rem;
    }

    .mb-1 {
        margin-bottom: 0.25rem;
    }

    .max-w-2xl {
        max-width: 42rem;
    }

    .drawer-body {
        flex: 1;
        overflow-y: auto;
    }

    .p-4 {
        padding: 1rem;
    }

    .action-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1rem;
    }

    .action-item {
        display: flex;
        align-items: center;
        padding: 1rem;
        background-color: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: background-color 0.15s ease-in-out;
        text-align: left;
        width: 100%;
        font-size: 0.875rem;
    }

    .action-item:hover {
        background-color: #f9fafb;
    }

    .nav-item {
        display: block;
        width: 100%;
        padding: 0.75rem 1rem;
        text-align: left;
        border-radius: 0.375rem;
        font-size: 0.875rem;
        color: #374151;
        background-color: transparent;
        border: none;
        cursor: pointer;
        transition: background-color 0.15s ease-in-out;
    }

    .nav-item:hover {
        background-color: #f3f4f6;
    }

    .bg-gray-50 {
        background-color: #f9fafb;
    }

    .bg-green-50 {
        background-color: #f0fdf4;
    }

    .border-green-200 {
        border-color: #bbf7d0;
    }

    .text-green-800 {
        color: #166534;
    }

    .rounded-lg {
        border-radius: 0.5rem;
    }

    .block {
        display: block;
    }

    .list-decimal {
        list-style-type: decimal;
    }

    .list-inside {
        list-style-position: inside;
    }
}
</style>
