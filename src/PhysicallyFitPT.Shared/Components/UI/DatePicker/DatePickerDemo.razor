@* Demo page showing DatePicker usage examples *@

<div class="space-y-8">
    <!-- Basic date picker -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Basic Date Picker</h3>
        <Card Class="max-w-2xl">
            <CardContent>
                <div class="space-y-4">
                    <div>
                        <label class="text-sm font-medium text-gray-700 block mb-2">Select a date</label>
                        <DatePicker 
                            Date="basicDate"
                            OnSelect="(date) => basicDate = date"
                            Placeholder="Pick a date" />
                    </div>
                    @if (basicDate.HasValue)
                    {
                        <p class="text-sm text-gray-600">Selected: <span class="font-semibold">@basicDate.Value.ToString("MMMM d, yyyy")</span></p>
                    }
                </div>
            </CardContent>
        </Card>
    </div>

    <!-- Date picker with constraints -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Date Picker with Min/Max</h3>
        <Card Class="max-w-2xl">
            <CardContent>
                <div class="space-y-4">
                    <div>
                        <label class="text-sm font-medium text-gray-700 block mb-2">Select appointment date (next 30 days)</label>
                        <DatePicker 
                            Date="constrainedDate"
                            OnSelect="(date) => constrainedDate = date"
                            MinDate="DateTime.Today"
                            MaxDate="DateTime.Today.AddDays(30)"
                            Placeholder="Pick an appointment date" />
                    </div>
                    @if (constrainedDate.HasValue)
                    {
                        <p class="text-sm text-gray-600">Appointment: <span class="font-semibold">@constrainedDate.Value.ToString("MMMM d, yyyy")</span></p>
                    }
                </div>
            </CardContent>
        </Card>
    </div>

    <!-- Date picker with error state -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Date Picker with Error</h3>
        <Card Class="max-w-2xl">
            <CardContent>
                <div class="space-y-4">
                    <div>
                        <label class="text-sm font-medium text-gray-700 block mb-2">Injury date (required)</label>
                        <DatePicker 
                            Date="errorDate"
                            OnSelect="(date) => errorDate = date"
                            HasError="@(!errorDate.HasValue)"
                            Placeholder="Pick injury date" />
                        @if (!errorDate.HasValue)
                        {
                            <p class="text-sm text-red-600 mt-1">Please select an injury date</p>
                        }
                    </div>
                </div>
            </CardContent>
        </Card>
    </div>

    <!-- Clinical use case: Intake assessment dates -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Clinical Use Case: Intake Assessment</h3>
        <Card Class="max-w-2xl">
            <CardHeader>
                <CardTitle>Patient Intake Form</CardTitle>
                <CardDescription>Fill in key dates for intake assessment</CardDescription>
            </CardHeader>
            <CardContent class="space-y-4">
                <div>
                    <label class="text-sm font-medium text-gray-700 block mb-2">Date of Injury</label>
                    <DatePicker 
                        Date="intakeInjuryDate"
                        OnSelect="(date) => intakeInjuryDate = date"
                        MaxDate="DateTime.Today"
                        Placeholder="Pick date of injury" />
                </div>

                <div>
                    <label class="text-sm font-medium text-gray-700 block mb-2">Referral Date</label>
                    <DatePicker 
                        Date="intakeReferralDate"
                        OnSelect="(date) => intakeReferralDate = date"
                        MinDate="intakeInjuryDate ?? DateTime.Today.AddMonths(-12)"
                        MaxDate="DateTime.Today"
                        Placeholder="Pick referral date" />
                </div>

                <div>
                    <label class="text-sm font-medium text-gray-700 block mb-2">Desired Return to Work</label>
                    <DatePicker 
                        Date="intakeReturnDate"
                        OnSelect="(date) => intakeReturnDate = date"
                        MinDate="DateTime.Today"
                        MaxDate="DateTime.Today.AddMonths(6)"
                        Placeholder="Pick target return date" />
                </div>
            </CardContent>
            <CardFooter>
                <Button>Save Intake</Button>
            </CardFooter>
        </Card>
    </div>

    <!-- Summary -->
    @if (basicDate.HasValue || constrainedDate.HasValue || intakeInjuryDate.HasValue)
    {
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <p class="text-sm text-blue-800">
                <span class="font-semibold">Selected dates:</span>
                @if (basicDate.HasValue) { <span>Basic: @basicDate.Value.ToString("M/d/yyyy") | </span> }
                @if (constrainedDate.HasValue) { <span>Appointment: @constrainedDate.Value.ToString("M/d/yyyy") | </span> }
                @if (intakeInjuryDate.HasValue) { <span>Injury: @intakeInjuryDate.Value.ToString("M/d/yyyy")</span> }
            </p>
        </div>
    }
</div>

@code {
    private DateTime? basicDate;
    private DateTime? constrainedDate;
    private DateTime? errorDate;
    private DateTime? intakeInjuryDate;
    private DateTime? intakeReferralDate;
    private DateTime? intakeReturnDate;
}

