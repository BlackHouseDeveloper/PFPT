@namespace PhysicallyFitPT.Shared.Components.UI

<button 
    class="toggle @GetToggleClass()" 
    data-slot="toggle"
    @onclick="OnToggle"
    disabled="@Disabled"
    aria-pressed="@IsPressed"
    @attributes="AdditionalAttributes">
    @ChildContent
</button>

@code {
    [Parameter]
    public string Variant { get; set; } = "default";

    [Parameter]
    public string Size { get; set; } = "default";

    [Parameter]
    public bool IsPressed { get; set; }

    [Parameter]
    public EventCallback<bool> IsPressedChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string GetToggleClass()
    {
        var baseClass = $"variant-{Variant} size-{Size}";
        if (!string.IsNullOrEmpty(Class))
        {
            baseClass = $"{baseClass} {Class}";
        }
        return baseClass;
    }

    private async Task OnToggle()
    {
        if (!Disabled)
        {
            IsPressed = !IsPressed;
            await IsPressedChanged.InvokeAsync(IsPressed);
        }
    }
}
