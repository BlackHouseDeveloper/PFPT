@* Demo page showing Command palette usage examples *@

<div class="space-y-8">
    <!-- Basic command palette -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Basic Command Palette</h3>
        <Card Class="max-w-2xl">
            <CardContent>
                <Command>
                    <CommandInput Placeholder="Search notes..." />
                    <CommandList>
                        <CommandEmpty>No notes found.</CommandEmpty>
                        <CommandGroup Label="Recent Notes">
                            <CommandItem Value="note-001" OnSelect="HandleItemSelect">
                                <span>Intake Assessment - John Doe</span>
                                <CommandShortcut>⌘K</CommandShortcut>
                            </CommandItem>
                            <CommandItem Value="note-002" OnSelect="HandleItemSelect">
                                <span>Follow-up Visit - Jane Smith</span>
                                <CommandShortcut>⌘J</CommandShortcut>
                            </CommandItem>
                        </CommandGroup>
                        <CommandSeparator />
                        <CommandGroup Label="Actions">
                            <CommandItem Value="new-note" OnSelect="HandleItemSelect">
                                <span>New Note</span>
                                <CommandShortcut>⌘N</CommandShortcut>
                            </CommandItem>
                            <CommandItem Value="export" OnSelect="HandleItemSelect">
                                <span>Export</span>
                                <CommandShortcut>⌘E</CommandShortcut>
                            </CommandItem>
                        </CommandGroup>
                    </CommandList>
                </Command>
            </CardContent>
        </Card>
    </div>

    <!-- Clinical command palette -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Clinical Workflows</h3>
        <Card Class="max-w-2xl">
            <CardContent>
                <Command>
                    <CommandInput Placeholder="Search workflows (e.g., SOAP, ROM, Intake)..." />
                    <CommandList>
                        <CommandEmpty>No workflows found.</CommandEmpty>
                        <CommandGroup Label="Documentation">
                            <CommandItem Value="soap" OnSelect="HandleItemSelect">
                                <span>SOAP Note Template</span>
                                <CommandShortcut>⌘1</CommandShortcut>
                            </CommandItem>
                            <CommandItem Value="rom" OnSelect="HandleItemSelect">
                                <span>Range of Motion Assessment</span>
                                <CommandShortcut>⌘2</CommandShortcut>
                            </CommandItem>
                            <CommandItem Value="special-test" OnSelect="HandleItemSelect">
                                <span>Special Tests</span>
                                <CommandShortcut>⌘3</CommandShortcut>
                            </CommandItem>
                        </CommandGroup>
                        <CommandSeparator />
                        <CommandGroup Label="Patient Management">
                            <CommandItem Value="intake" OnSelect="HandleItemSelect">
                                <span>New Intake Assessment</span>
                                <CommandShortcut>⌘I</CommandShortcut>
                            </CommandItem>
                            <CommandItem Value="schedule" OnSelect="HandleItemSelect">
                                <span>Schedule Appointment</span>
                                <CommandShortcut>⌘S</CommandShortcut>
                            </CommandItem>
                        </CommandGroup>
                        <CommandSeparator />
                        <CommandGroup Label="Settings">
                            <CommandItem Value="prefs" OnSelect="HandleItemSelect">
                                <span>Preferences</span>
                                <CommandShortcut>⌘,</CommandShortcut>
                            </CommandItem>
                            <CommandItem Value="help" OnSelect="HandleItemSelect">
                                <span>Help & Documentation</span>
                                <CommandShortcut>⌘?</CommandShortcut>
                            </CommandItem>
                        </CommandGroup>
                    </CommandList>
                </Command>
            </CardContent>
        </Card>
    </div>

    <!-- Disabled state -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Disabled Items</h3>
        <Card Class="max-w-2xl">
            <CardContent>
                <Command>
                    <CommandInput Placeholder="Search..." />
                    <CommandList>
                        <CommandEmpty>No items available.</CommandEmpty>
                        <CommandGroup Label="Quick Actions">
                            <CommandItem Value="enabled1" OnSelect="HandleItemSelect">
                                <span>Available Action</span>
                            </CommandItem>
                            <CommandItem Value="disabled1" Disabled="true">
                                <span>Disabled (requires admin)</span>
                            </CommandItem>
                            <CommandItem Value="enabled2" OnSelect="HandleItemSelect">
                                <span>Another Available Action</span>
                            </CommandItem>
                        </CommandGroup>
                    </CommandList>
                </Command>
            </CardContent>
        </Card>
    </div>
</div>

@code {
    private void HandleItemSelect(string value)
    {
        Console.WriteLine($"Selected: {value}");
    }

    private string selectedValue = "";
}

<style>
    .space-y-8 > * + * {
        margin-top: 2rem;
    }

    .text-sm {
        font-size: 0.875rem;
        line-height: 1.25rem;
    }

    .font-semibold {
        font-weight: 600;
    }

    .text-gray-700 {
        color: #374151;
    }

    .mb-3 {
        margin-bottom: 0.75rem;
    }

    .max-w-2xl {
        max-width: 42rem;
    }
</style>
