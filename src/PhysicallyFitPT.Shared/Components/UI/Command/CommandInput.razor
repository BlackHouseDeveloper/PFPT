@* Search input field for command palette *@
@namespace PhysicallyFitPT.Shared.Components.UI.Command

<div class="command-input-wrapper">
    <svg class="command-search-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
    </svg>
    <input 
        type="text" 
        class="command-input"
        placeholder="@Placeholder"
        @bind="searchValue"
        @bind:event="oninput"
        @onkeydown="HandleKeyDown"
        @attributes="AdditionalAttributes" />
</div>

@code {
    [CascadingParameter]
    public Command? ParentCommand { get; set; }

    [Parameter]
    public string? Placeholder { get; set; } = "Search commands...";

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string searchValue = string.Empty;

    protected override void OnInitialized()
    {
        if (ParentCommand != null)
        {
            searchValue = ParentCommand.GetSearchQuery();
        }
    }

    private void HandleInputChange()
    {
        if (ParentCommand != null)
        {
            ParentCommand.SetSearchQuery(searchValue);
        }
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "ArrowDown")
        {
            if (ParentCommand != null)
            {
                var currentIndex = ParentCommand.GetSelectedIndex();
                ParentCommand.SelectItem(currentIndex + 1);
            }
        }
        else if (args.Key == "ArrowUp")
        {
            if (ParentCommand != null)
            {
                var currentIndex = ParentCommand.GetSelectedIndex();
                if (currentIndex > 0)
                {
                    ParentCommand.SelectItem(currentIndex - 1);
                }
            }
        }
    }
}
