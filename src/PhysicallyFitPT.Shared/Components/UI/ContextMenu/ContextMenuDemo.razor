@* Demo page showing ContextMenu usage examples *@

<div class="space-y-8">
    <!-- Basic context menu -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Basic Context Menu (Right-Click)</h3>
        <Card Class="max-w-2xl">
            <CardContent>
                <ContextMenu>
                    <div class="context-demo-area">
                        Right-click anywhere in this area
                    </div>
                    <ContextMenuGroup>
                        <ContextMenuItem OnClick="() => HandleAction('Edit')">
                            <span>Edit</span>
                            <ContextMenuShortcut>⌘E</ContextMenuShortcut>
                        </ContextMenuItem>
                        <ContextMenuItem OnClick="() => HandleAction('Duplicate')">
                            <span>Duplicate</span>
                            <ContextMenuShortcut>⌘D</ContextMenuShortcut>
                        </ContextMenuItem>
                    </ContextMenuGroup>
                    <ContextMenuSeparator />
                    <ContextMenuGroup>
                        <ContextMenuItem OnClick="() => HandleAction('Cut')">
                            <span>Cut</span>
                            <ContextMenuShortcut>⌘X</ContextMenuShortcut>
                        </ContextMenuItem>
                        <ContextMenuItem OnClick="() => HandleAction('Copy')">
                            <span>Copy</span>
                            <ContextMenuShortcut>⌘C</ContextMenuShortcut>
                        </ContextMenuItem>
                        <ContextMenuItem OnClick="() => HandleAction('Paste')">
                            <span>Paste</span>
                            <ContextMenuShortcut>⌘V</ContextMenuShortcut>
                        </ContextMenuItem>
                    </ContextMenuGroup>
                    <ContextMenuSeparator />
                    <ContextMenuGroup>
                        <ContextMenuItem Variant="destructive" OnClick="() => HandleAction('Delete')">
                            <span>Delete</span>
                            <ContextMenuShortcut>Del</ContextMenuShortcut>
                        </ContextMenuItem>
                    </ContextMenuGroup>
                </ContextMenu>
            </CardContent>
        </Card>
    </div>

    <!-- Checkbox items -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Context Menu with Checkboxes</h3>
        <Card Class="max-w-2xl">
            <CardContent>
                <ContextMenu>
                    <div class="context-demo-area">
                        Right-click for view options
                    </div>
                    <ContextMenuLabel>View Options</ContextMenuLabel>
                    <ContextMenuCheckboxItem Checked="showPatientIds" OnCheckedChange="(val) => showPatientIds = val">
                        Show Patient IDs
                    </ContextMenuCheckboxItem>
                    <ContextMenuCheckboxItem Checked="showDates" OnCheckedChange="(val) => showDates = val">
                        Show Visit Dates
                    </ContextMenuCheckboxItem>
                    <ContextMenuCheckboxItem Checked="showNotes" OnCheckedChange="(val) => showNotes = val">
                        Show Notes Preview
                    </ContextMenuCheckboxItem>
                </ContextMenu>
            </CardContent>
        </Card>
    </div>

    <!-- Radio items -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Context Menu with Radio Buttons</h3>
        <Card Class="max-w-2xl">
            <CardContent>
                <ContextMenu>
                    <div class="context-demo-area">
                        Right-click to change view mode
                    </div>
                    <ContextMenuLabel>Sort By</ContextMenuLabel>
                    <ContextMenuRadioItem Value="date" OnSelect="(val) => HandleSort(val)">
                        Date
                    </ContextMenuRadioItem>
                    <ContextMenuRadioItem Value="patient" OnSelect="(val) => HandleSort(val)">
                        Patient Name
                    </ContextMenuRadioItem>
                    <ContextMenuRadioItem Value="type" OnSelect="(val) => HandleSort(val)">
                        Note Type
                    </ContextMenuRadioItem>
                </ContextMenu>
            </CardContent>
        </Card>
    </div>

    <!-- Clinical context menu -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Clinical Use Case: Note Actions</h3>
        <Card Class="max-w-2xl">
            <CardContent>
                <ContextMenu>
                    <div class="context-demo-area">
                        Right-click on a note
                    </div>
                    <ContextMenuLabel>Note Actions</ContextMenuLabel>
                    <ContextMenuItem OnClick="() => HandleAction('Open')">
                        Open Note
                    </ContextMenuItem>
                    <ContextMenuItem OnClick="() => HandleAction('Edit')">
                        Edit Note
                    </ContextMenuItem>
                    <ContextMenuSeparator />
                    <ContextMenuLabel>Export</ContextMenuLabel>
                    <ContextMenuItem OnClick="() => HandleAction('ExportPDF')">
                        Export to PDF
                    </ContextMenuItem>
                    <ContextMenuItem OnClick="() => HandleAction('Print')">
                        Print
                    </ContextMenuItem>
                    <ContextMenuSeparator />
                    <ContextMenuLabel>Archive</ContextMenuLabel>
                    <ContextMenuItem OnClick="() => HandleAction('Archive')">
                        Archive
                    </ContextMenuItem>
                    <ContextMenuItem Variant="destructive" OnClick="() => HandleAction('DeleteNote')">
                        Delete Permanently
                    </ContextMenuItem>
                </ContextMenu>
            </CardContent>
        </Card>
    </div>

    <!-- Status message -->
    @if (!string.IsNullOrEmpty(lastAction))
    {
        <div class="bg-green-50 border border-green-200 rounded-lg p-4">
            <p class="text-sm text-green-800">
                <span class="font-semibold">Last action:</span> @lastAction
            </p>
        </div>
    }
</div>

@code {
    private string? lastAction;
    private bool showPatientIds = true;
    private bool showDates = true;
    private bool showNotes = false;

    private void HandleAction(string action)
    {
        lastAction = action;
    }

    private void HandleSort(string sortBy)
    {
        lastAction = $"Sorted by: {sortBy}";
    }
}

