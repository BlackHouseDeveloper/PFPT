@* Demo page showing Chart usage examples *@

<div class="space-y-8">
    <!-- Important Note -->
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
        <div class="flex gap-3">
            <div class="text-2xl">⚠️</div>
            <div>
                <h3 class="text-sm font-semibold text-yellow-900 mb-1">Chart Component - Implementation Note</h3>
                <p class="text-sm text-yellow-800">
                    The Chart component is a placeholder that requires JavaScript charting library integration 
                    (e.g., Chart.js, ApexCharts) via JS interop. The examples below show the intended structure 
                    and clinical use cases. Full implementation would require:
                </p>
                <ul class="text-sm text-yellow-800 mt-2 space-y-1 list-disc list-inside">
                    <li>JS charting library (Chart.js recommended)</li>
                    <li>JS interop to initialize charts</li>
                    <li>Data binding and chart update logic</li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Chart Structure Examples -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Basic Chart Structure</h3>
        <Card Class="max-w-2xl">
            <CardHeader>
                <CardTitle>Line Chart Example</CardTitle>
                <CardDescription>Patient progress over time</CardDescription>
            </CardHeader>
            <CardContent>
                <Chart Type="Chart.ChartType.Line" 
                       Config="lineChartConfig"
                       ShowLegend="true" />
            </CardContent>
        </Card>
    </div>

    <!-- Clinical Use Case: Pain Tracking -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Clinical Use Case: Pain Level Tracking</h3>
        <Card Class="max-w-2xl">
            <CardHeader>
                <CardTitle>Pain Level Over Treatment Period</CardTitle>
                <CardDescription>Sarah Johnson - Lumbar Radiculopathy</CardDescription>
            </CardHeader>
            <CardContent>
                <div class="space-y-4">
                    <!-- Placeholder for line chart -->
                    <div class="aspect-video bg-gray-50 border border-gray-200 rounded-lg flex items-center justify-center">
                        <div class="text-center text-gray-500">
                            <div class="text-sm font-medium mb-2">Pain Level Chart</div>
                            <div class="text-xs">Line chart showing pain reduction from 7/10 to 2/10 over 3 weeks</div>
                            <div class="text-xs text-gray-400 mt-2">(Requires Chart.js integration)</div>
                        </div>
                    </div>
                    
                    <!-- Manual legend -->
                    <div class="flex justify-center gap-4 pt-2 border-t">
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 rounded-sm" style="background-color: #ef4444;"></div>
                            <span class="text-xs text-gray-600">Pain Level</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 rounded-sm" style="background-color: #9BE000;"></div>
                            <span class="text-xs text-gray-600">Target (3/10)</span>
                        </div>
                    </div>

                    <!-- Data summary -->
                    <div class="grid grid-cols-3 gap-4 pt-4 border-t">
                        <div>
                            <div class="text-xs text-gray-500">Initial</div>
                            <div class="text-xl font-semibold text-red-600">7/10</div>
                        </div>
                        <div>
                            <div class="text-xs text-gray-500">Current</div>
                            <div class="text-xl font-semibold text-green-600">2/10</div>
                        </div>
                        <div>
                            <div class="text-xs text-gray-500">Improvement</div>
                            <div class="text-xl font-semibold text-green-600">-71%</div>
                        </div>
                    </div>
                </div>
            </CardContent>
        </Card>
    </div>

    <!-- Clinical Use Case: ROM Progress -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Clinical Use Case: Range of Motion Progress</h3>
        <Card Class="max-w-2xl">
            <CardHeader>
                <CardTitle>Shoulder Flexion ROM</CardTitle>
                <CardDescription>Michael Chen - Rotator Cuff Repair</CardDescription>
            </CardHeader>
            <CardContent>
                <div class="space-y-4">
                    <!-- Placeholder for bar chart -->
                    <div class="aspect-video bg-gray-50 border border-gray-200 rounded-lg flex items-center justify-center">
                        <div class="text-center text-gray-500">
                            <div class="text-sm font-medium mb-2">ROM Progress Chart</div>
                            <div class="text-xs">Bar chart comparing baseline, current, and target ROM</div>
                            <div class="text-xs text-gray-400 mt-2">(Requires Chart.js integration)</div>
                        </div>
                    </div>

                    <!-- Manual visualization with bars -->
                    <div class="space-y-3">
                        <div>
                            <div class="flex justify-between text-xs text-gray-600 mb-1">
                                <span>Baseline (Week 1)</span>
                                <span>45°</span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-3">
                                <div class="bg-red-500 h-3 rounded-full" style="width: 25%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-xs text-gray-600 mb-1">
                                <span>Current (Week 6)</span>
                                <span>135°</span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-3">
                                <div class="bg-blue-500 h-3 rounded-full" style="width: 75%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-xs text-gray-600 mb-1">
                                <span>Target (Week 12)</span>
                                <span>180°</span>
                            </div>
                            <div class="w-full bg-gray-200 rounded-full h-3">
                                <div class="bg-primary h-3 rounded-full" style="width: 100%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </CardContent>
        </Card>
    </div>

    <!-- Clinical Use Case: Visit Statistics -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Clinical Use Case: Monthly Visit Distribution</h3>
        <div class="grid md:grid-cols-2 gap-4 max-w-4xl">
            <Card>
                <CardHeader>
                    <CardTitle>Visit Types - January 2026</CardTitle>
                    <CardDescription>Distribution by visit category</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="space-y-4">
                        <!-- Placeholder for doughnut chart -->
                        <div class="aspect-square max-w-xs mx-auto bg-gray-50 border border-gray-200 rounded-lg flex items-center justify-center">
                            <div class="text-center text-gray-500">
                                <div class="text-sm font-medium mb-2">Doughnut Chart</div>
                                <div class="text-xs">Visit type distribution</div>
                            </div>
                        </div>

                        <!-- Manual breakdown -->
                        <div class="space-y-2 text-sm">
                            <div class="flex justify-between items-center">
                                <div class="flex items-center gap-2">
                                    <div class="w-3 h-3 rounded-sm bg-blue-500"></div>
                                    <span>Evaluation</span>
                                </div>
                                <span class="font-medium">24 (30%)</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <div class="flex items-center gap-2">
                                    <div class="w-3 h-3 rounded-sm bg-green-500"></div>
                                    <span>Treatment</span>
                                </div>
                                <span class="font-medium">48 (60%)</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <div class="flex items-center gap-2">
                                    <div class="w-3 h-3 rounded-sm bg-yellow-500"></div>
                                    <span>Re-evaluation</span>
                                </div>
                                <span class="font-medium">8 (10%)</span>
                            </div>
                        </div>
                    </div>
                </CardContent>
            </Card>

            <Card>
                <CardHeader>
                    <CardTitle>Weekly Visit Volume</CardTitle>
                    <CardDescription>Appointments per week</CardDescription>
                </CardHeader>
                <CardContent>
                    <div class="space-y-4">
                        <!-- Placeholder for bar chart -->
                        <div class="aspect-video bg-gray-50 border border-gray-200 rounded-lg flex items-center justify-center">
                            <div class="text-center text-gray-500">
                                <div class="text-sm font-medium mb-2">Bar Chart</div>
                                <div class="text-xs">Weekly appointments</div>
                            </div>
                        </div>

                        <!-- Manual breakdown -->
                        <div class="grid grid-cols-4 gap-2 text-xs">
                            <div class="text-center">
                                <div class="text-gray-500 mb-1">Week 1</div>
                                <div class="font-semibold text-lg">18</div>
                            </div>
                            <div class="text-center">
                                <div class="text-gray-500 mb-1">Week 2</div>
                                <div class="font-semibold text-lg">22</div>
                            </div>
                            <div class="text-center">
                                <div class="text-gray-500 mb-1">Week 3</div>
                                <div class="font-semibold text-lg">20</div>
                            </div>
                            <div class="text-center">
                                <div class="text-gray-500 mb-1">Week 4</div>
                                <div class="font-semibold text-lg">21</div>
                            </div>
                        </div>
                    </div>
                </CardContent>
            </Card>
        </div>
    </div>

    <!-- Implementation Guide -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Implementation Guide</h3>
        <Card Class="max-w-2xl">
            <CardHeader>
                <CardTitle>Adding Chart.js Integration</CardTitle>
                <CardDescription>Steps to enable full chart functionality</CardDescription>
            </CardHeader>
            <CardContent>
                <div class="space-y-3 text-sm">
                    <div>
                        <div class="font-medium text-gray-900 mb-1">1. Add Chart.js CDN or npm package</div>
                        <code class="block bg-gray-100 p-2 rounded text-xs">
                            &lt;script src="https://cdn.jsdelivr.net/npm/chart.js"&gt;&lt;/script&gt;
                        </code>
                    </div>
                    <div>
                        <div class="font-medium text-gray-900 mb-1">2. Create JS interop functions</div>
                        <code class="block bg-gray-100 p-2 rounded text-xs">
                            window.initChart = (canvas, type, data, config) => {{ "{ /* ... */ }" }}
                        </code>
                    </div>
                    <div>
                        <div class="font-medium text-gray-900 mb-1">3. Call from Blazor component</div>
                        <code class="block bg-gray-100 p-2 rounded text-xs">
                            await JSRuntime.InvokeVoidAsync("initChart", canvasRef, ...);
                        </code>
                    </div>
                    <div class="pt-2 border-t">
                        <div class="font-medium text-gray-900 mb-1">Recommended Libraries:</div>
                        <ul class="list-disc list-inside space-y-1 text-gray-600">
                            <li>Chart.js - Simple, flexible charts</li>
                            <li>ApexCharts - Modern, interactive charts</li>
                            <li>Blazor.Charts (NuGet) - Native Blazor wrapper</li>
                        </ul>
                    </div>
                </div>
            </CardContent>
        </Card>
    </div>
</div>

<style>
    .aspect-square {
        aspect-ratio: 1 / 1;
    }

    .max-w-xs {
        max-width: 20rem;
    }

    .mx-auto {
        margin-left: auto;
        margin-right: auto;
    }

    .bg-primary {
        background-color: #9BE000;
    }

    .text-red-600 {
        color: #dc2626;
    }

    .text-green-600 {
        color: #16a34a;
    }

    .bg-red-500 {
        background-color: #ef4444;
    }

    .bg-blue-500 {
        background-color: #3b82f6;
    }

    .bg-green-500 {
        background-color: #22c55e;
    }

    .bg-yellow-500 {
        background-color: #eab308;
    }

    .bg-yellow-50 {
        background-color: #fefce8;
    }

    .border-yellow-200 {
        border-color: #fef08a;
    }

    .text-yellow-800 {
        color: #854d0e;
    }

    .text-yellow-900 {
        color: #713f12;
    }

    .list-disc {
        list-style-type: disc;
    }

    .list-inside {
        list-style-position: inside;
    }
</style>

@code {
    private Dictionary<string, Chart.ChartConfigItem> lineChartConfig = new()
    {
        { "pain", new Chart.ChartConfigItem { Label = "Pain Level", Color = "#ef4444" } },
        { "target", new Chart.ChartConfigItem { Label = "Target", Color = "#9BE000" } }
    };
}
