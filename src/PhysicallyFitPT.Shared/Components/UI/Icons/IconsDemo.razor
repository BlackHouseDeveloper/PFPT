@* Icons Demo - Comprehensive icon showcase *@
@page "/demo/icons"
@namespace PhysicallyFitPT.Shared.Components.UI

<div class="demo-container">
    <h1>Icons</h1>
    <p class="demo-description">
        Lucide-inspired icon library with scalable SVG icons for clinical applications.
        All icons support custom sizing, stroke width, and CSS classes.
    </p>

    <div class="demo-section">
        <h2>Common Icons</h2>
        <p>Frequently used icons across the application.</p>
        <div class="demo-example">
            <div class="icon-grid">
                <div class="icon-item">
                    <CheckIcon Width="32" Height="32" CssClass="icon-demo" />
                    <span>Check</span>
                </div>
                <div class="icon-item">
                    <XIcon Width="32" Height="32" CssClass="icon-demo" />
                    <span>X (Close)</span>
                </div>
                <div class="icon-item">
                    <ChevronDownIcon Width="32" Height="32" CssClass="icon-demo" />
                    <span>Chevron Down</span>
                </div>
                <div class="icon-item">
                    <Icon Name="chevronleft" Width="32" Height="32" CssClass="icon-demo" />
                    <span>Chevron Left</span>
                </div>
                <div class="icon-item">
                    <Icon Name="chevronright" Width="32" Height="32" CssClass="icon-demo" />
                    <span>Chevron Right</span>
                </div>
                <div class="icon-item">
                    <Icon Name="chevronup" Width="32" Height="32" CssClass="icon-demo" />
                    <span>Chevron Up</span>
                </div>
            </div>
        </div>
    </div>

    <div class="demo-section">
        <h2>Navigation Icons</h2>
        <p>Icons for navigation and UI controls.</p>
        <div class="demo-example">
