    <div class="demo-section">
        <h2>Stroke Width</h2>
        <p>Adjust icon stroke thickness.</p>
        <div class="demo-example">
            <div style="display: flex; align-items: center; gap: 24px;">
                <div class="icon-item">
                    <Icon Name="heart" Width="32" Height="32" StrokeWidth="1" CssClass="icon-demo" />
                    <span>1px</span>
                </div>
                <div class="icon-item">
                    <Icon Name="heart" Width="32" Height="32" StrokeWidth="2" CssClass="icon-demo" />
                    <span>2px</span>
                </div>
                <div class="icon-item">
                    <Icon Name="heart" Width="32" Height="32" StrokeWidth="3" CssClass="icon-demo" />
                    <span>3px</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .icon-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
        gap: 24px;
        padding: 16px;
    }

    .icon-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        text-align: center;
    }

    .icon-item span {
        font-size: 12px;
        color: #6b7280;
    }

    .icon-demo {
        color: #0B2545;
    }

    .icon-success {
        color: #10b981;
    }

    .icon-warning {
        color: #f59e0b;
    }

    .icon-error {
        color: #dc2626;
    }

    .icon-info {
        color: #3b82f6;
    }

    .animate-spin {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }
</style>

