    <div class="demo-section">
        <h2>Size Variants</h2>
        <p>Icons can be rendered at different sizes.</p>
        <div class="demo-example">
            <div style="display: flex; align-items: center; gap: 24px;">
                <div class="icon-item">
                    <Icon Name="user" Width="16" Height="16" CssClass="icon-demo" />
                    <span>16px</span>
                </div>
                <div class="icon-item">
                    <Icon Name="user" Width="24" Height="24" CssClass="icon-demo" />
                    <span>24px</span>
                </div>
                <div class="icon-item">
                    <Icon Name="user" Width="32" Height="32" CssClass="icon-demo" />
                    <span>32px</span>
