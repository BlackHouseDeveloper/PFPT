@namespace PhysicallyFitPT.Shared.Components.UI.Icons

<svg xmlns="http://www.w3.org/2000/svg" width="@Width" height="@Height" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@Class">
    <polyline points="9 18 15 12 9 6" />
</svg>

@code {
    [Parameter]
    public string Width { get; set; } = "16";

    [Parameter]
    public string Height { get; set; } = "16";

    [Parameter]
    public string? Class { get; set; }
}
