@* Demo page showing Calendar usage examples *@

<div class="space-y-8">
    <!-- Single Date Selection -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Single Date Selection</h3>
        <div class="flex flex-col gap-4">
            <div class="inline-block border border-gray-200 rounded-lg">
                <Calendar @bind-SelectedDate="singleDate" Mode="single" />
            </div>
            @if (singleDate.HasValue)
            {
                <div class="text-sm text-gray-600">
                    Selected: <span class="font-medium">@singleDate.Value.ToString("MMMM dd, yyyy")</span>
                </div>
            }
            else
            {
                <div class="text-sm text-gray-500">No date selected</div>
            }
        </div>
    </div>

    <!-- Date Range Selection -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Date Range Selection</h3>
        <div class="flex flex-col gap-4">
            <div class="inline-block border border-gray-200 rounded-lg">
                <Calendar @bind-RangeStart="rangeStart" 
                         @bind-RangeEnd="rangeEnd" 
                         Mode="range" />
            </div>
            <div class="text-sm text-gray-600">
                @if (rangeStart.HasValue && rangeEnd.HasValue)
                {
                    <div>
                        Range: <span class="font-medium">@rangeStart.Value.ToString("MMM dd, yyyy")</span> to 
                        <span class="font-medium">@rangeEnd.Value.ToString("MMM dd, yyyy")</span>
                    </div>
                    <div class="text-xs text-gray-500 mt-1">
                        Duration: @((rangeEnd.Value - rangeStart.Value).Days + 1) days
                    </div>
                }
                else if (rangeStart.HasValue)
                {
                    <div class="text-gray-500">Start: @rangeStart.Value.ToString("MMM dd, yyyy") (select end date)</div>
                }
                else
                {
                    <div class="text-gray-500">Select start and end dates</div>
                }
            </div>
        </div>
    </div>

    <!-- Calendar with Min/Max Dates -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Calendar with Date Restrictions</h3>
        <div class="flex flex-col gap-4">
            <div class="inline-block border border-gray-200 rounded-lg">
                <Calendar @bind-SelectedDate="restrictedDate" 
                         MinDate="minDate" 
                         MaxDate="maxDate" 
                         Mode="single" />
            </div>
            <div class="text-sm text-gray-600">
                <div>Min: <span class="font-medium">@minDate.ToString("MMM dd, yyyy")</span></div>
                <div>Max: <span class="font-medium">@maxDate.ToString("MMM dd, yyyy")</span></div>
                @if (restrictedDate.HasValue)
                {
                    <div class="mt-2">Selected: <span class="font-medium">@restrictedDate.Value.ToString("MMMM dd, yyyy")</span></div>
                }
            </div>
        </div>
    </div>

    <!-- Calendar without Outside Days -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Calendar without Outside Days</h3>
        <div class="inline-block border border-gray-200 rounded-lg">
            <Calendar @bind-SelectedDate="noOutsideDate" 
                     ShowOutsideDays="false" 
                     Mode="single" />
        </div>
    </div>

    <!-- Clinical Use Cases -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Clinical Use Case: Appointment Scheduling</h3>
        <div class="bg-gray-50 p-4 rounded-lg space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Select Appointment Date</label>
                <div class="inline-block border border-gray-200 rounded-lg bg-white">
                    <Calendar @bind-SelectedDate="appointmentDate" 
                             MinDate="DateTime.Today"
                             DisabledDates="@IsWeekend"
                             Mode="single" />
                </div>
            </div>
            
            @if (appointmentDate.HasValue)
            {
                <div class="p-3 bg-white border border-gray-200 rounded-md">
                    <div class="text-sm font-medium text-gray-900">Appointment Details</div>
                    <div class="text-sm text-gray-600 mt-1">
                        Date: @appointmentDate.Value.ToString("dddd, MMMM dd, yyyy")
                    </div>
                    <div class="flex gap-2 mt-3">
                        <Button Size="sm">9:00 AM</Button>
                        <Button Size="sm" Variant="outline">10:30 AM</Button>
                        <Button Size="sm" Variant="outline">2:00 PM</Button>
                        <Button Size="sm" Variant="outline">3:30 PM</Button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Treatment Plan Duration -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Clinical Use Case: Treatment Plan Duration</h3>
        <div class="bg-gray-50 p-4 rounded-lg space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Select Treatment Period</label>
                <div class="inline-block border border-gray-200 rounded-lg bg-white">
                    <Calendar @bind-RangeStart="treatmentStart" 
                             @bind-RangeEnd="treatmentEnd"
                             MinDate="DateTime.Today"
                             Mode="range" />
                </div>
            </div>

            @if (treatmentStart.HasValue && treatmentEnd.HasValue)
            {
                <div class="p-3 bg-white border border-gray-200 rounded-md">
                    <div class="text-sm font-medium text-gray-900">Treatment Plan Summary</div>
                    <div class="grid grid-cols-2 gap-4 mt-2 text-sm">
                        <div>
                            <div class="text-gray-500">Start Date</div>
                            <div class="font-medium">@treatmentStart.Value.ToString("MMM dd, yyyy")</div>
                        </div>
                        <div>
                            <div class="text-gray-500">End Date</div>
                            <div class="font-medium">@treatmentEnd.Value.ToString("MMM dd, yyyy")</div>
                        </div>
                        <div>
                            <div class="text-gray-500">Duration</div>
                            <div class="font-medium">@((treatmentEnd.Value - treatmentStart.Value).Days + 1) days</div>
                        </div>
                        <div>
                            <div class="text-gray-500">Est. Sessions</div>
                            <div class="font-medium">@(((treatmentEnd.Value - treatmentStart.Value).Days + 1) / 3) sessions</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private DateTime? singleDate = DateTime.Today;
    private DateTime? rangeStart;
    private DateTime? rangeEnd;
    
    private DateTime? restrictedDate;
    private DateTime minDate = DateTime.Today.AddDays(-7);
    private DateTime maxDate = DateTime.Today.AddDays(30);
    
    private DateTime? noOutsideDate;
    
    private DateTime? appointmentDate;
    private DateTime? treatmentStart;
    private DateTime? treatmentEnd;

    private bool IsWeekend(DateTime date)
    {
        return date.DayOfWeek == DayOfWeek.Saturday || date.DayOfWeek == DayOfWeek.Sunday;
    }
}
