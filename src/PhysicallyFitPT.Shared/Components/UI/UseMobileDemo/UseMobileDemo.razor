@page "/components/use-mobile-demo"
@namespace PhysicallyFitPT.Shared.Components.UI
@using PhysicallyFitPT.Shared.Services
@inject IsMobileService MobileService
@implements IAsyncDisposable

<PageTitle>useIsMobile Hook Demo (Blazor Service)</PageTitle>

<div class="component-demo">
    <div class="demo-header">
        <h1>useIsMobile / IsMobileService</h1>
        <p>Reactive viewport size detection using media queries. Provides real-time mobile state tracking across components.</p>
    </div>

    @if (!MobileService.IsInitialized)
    {
        <div class="demo-section">
            <p class="loading-message">Initializing mobile detection service...</p>
        </div>
    }
    else
    {
        <!-- Current Status -->
        <section class="demo-section">
            <h2>Current Status</h2>
            <div class="demo-box">
                <div class="status-display">
                    <div class="status-indicator">
                        <span class="status-badge @(MobileService.IsMobile ? "mobile" : "desktop")">
                            @(MobileService.IsMobile ? "📱 Mobile" : "🖥️ Desktop")
                        </span>
                    </div>
                    <div class="status-info">
                        <p>Current viewport width: <strong>@ViewportWidth</strong>px</p>
                        <p>Breakpoint: <strong>768</strong>px</p>
                        <p>Status: <strong>@(MobileService.IsMobile ? "Mobile view" : "Desktop view")</strong></p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Responsive Layout Demo -->
        <section class="demo-section">
            <h2>Responsive Layout</h2>
            <p>The layout below adjusts based on viewport size.</p>
            <div class="demo-box responsive-demo">
                @if (MobileService.IsMobile)
                {
                    <div class="mobile-layout">
                        <h3>Mobile Layout</h3>
                        <div class="stack">
                            <div class="card">Card 1</div>
                            <div class="card">Card 2</div>
                            <div class="card">Card 3</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="desktop-layout">
                        <h3>Desktop Layout</h3>
                        <div class="grid">
                            <div class="card">Card 1</div>
                            <div class="card">Card 2</div>
                            <div class="card">Card 3</div>
                        </div>
                    </div>
                }
            </div>
        </section>

        <!-- Clinical Use Cases -->
        <section class="demo-section">
            <h2>Clinical Use Cases</h2>
            <div class="demo-box">
                <div class="clinical-use-case">
                    <h3>Patient List Display</h3>
                    <p>Adjusts patient data presentation based on device:</p>
                    @if (MobileService.IsMobile)
                    {
                        <div class="patient-list-mobile">
                            <div class="patient-item">
                                <strong>Jane Smith</strong><br/>
                                <small>DOB: 1965-05-15</small>
                            </div>
                            <div class="patient-item">
                                <strong>John Doe</strong><br/>
                                <small>DOB: 1978-12-20</small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <table class="patient-list-desktop">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>DOB</th>
                                    <th>Phone</th>
                                    <th>Last Visit</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Jane Smith</td>
                                    <td>1965-05-15</td>
                                    <td>(555) 123-4567</td>
                                    <td>2024-01-18</td>
                                    <td>Active</td>
                                </tr>
                                <tr>
                                    <td>John Doe</td>
                                    <td>1978-12-20</td>
                                    <td>(555) 987-6543</td>
                                    <td>2024-01-15</td>
                                    <td>Active</td>
                                </tr>
                            </tbody>
                        </table>
                    }
                </div>

                <div class="clinical-use-case">
                    <h3>Dashboard Metrics</h3>
                    <p>Shows appropriate amount of data based on screen size:</p>
                    @if (MobileService.IsMobile)
                    {
                        <div class="metrics-mobile">
                            <div class="metric-card">
                                <div class="metric-value">12</div>
                                <div class="metric-label">Active Patients</div>
                            </div>
                            <div class="metric-card">
                                <div class="metric-value">8</div>
                                <div class="metric-label">This Week</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="metrics-desktop">
                            <div class="metric-card">
                                <div class="metric-value">12</div>
                                <div class="metric-label">Active Patients</div>
                            </div>
                            <div class="metric-card">
                                <div class="metric-value">8</div>
                                <div class="metric-label">Visits This Week</div>
                            </div>
                            <div class="metric-card">
                                <div class="metric-value">96%</div>
                                <div class="metric-label">Completion Rate</div>
                            </div>
                            <div class="metric-card">
                                <div class="metric-value">4.8</div>
                                <div class="metric-label">Avg. Session Rating</div>
                            </div>
                        </div>
                    }
                </div>

                <div class="clinical-use-case">
                    <h3>Navigation Adjustments</h3>
                    <p>Navigation style adapts to available space:</p>
                    @if (MobileService.IsMobile)
                    {
                        <div class="nav-mobile">
                            <button class="nav-button">📋 Patients</button>
                            <button class="nav-button">📅 Schedule</button>
                            <button class="nav-button">⚙️ Settings</button>
                        </div>
                    }
                    else
                    {
                        <div class="nav-desktop">
                            <button class="nav-button">Patients</button>
                            <button class="nav-button">Schedule</button>
                            <button class="nav-button">Reports</button>
                            <button class="nav-button">Settings</button>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- Implementation Example -->
        <section class="demo-section">
            <h2>Implementation Example</h2>
            <p>How to use IsMobileService in your Blazor components:</p>
            <pre><code>@@page "/my-page"
@@using PhysicallyFitPT.Shared.Services
@@inject IsMobileService MobileService

@@code {
    protected override async Task OnInitializedAsync()
    {
        await MobileService.InitializeAsync();
        MobileService.OnMobileStateChanged += OnMobileStateChanged;
    }

    private void OnMobileStateChanged(object? sender, bool isMobile)
    {
        StateHasChanged(); // Trigger re-render
    }

    private void Dispose()
    {
        MobileService.OnMobileStateChanged -= OnMobileStateChanged;
    }
}
</code></pre>
            <pre><code>@@if (MobileService.IsMobile)
{
    // Mobile layout
}
else
{
    // Desktop layout
}</code></pre>
        </section>

        <!-- Features -->
        <section class="demo-section">
            <h2>Features</h2>
            <ul class="features-list">
                <li><strong>Reactive State</strong> — Real-time viewport tracking with media queries</li>
                <li><strong>768px Breakpoint</strong> — Standard mobile/desktop boundary</li>
                <li><strong>Event-Based</strong> — OnMobileStateChanged event for component updates</li>
                <li><strong>JS Interop</strong> — Efficient JavaScript integration for performance</li>
                <li><strong>Automatic Cleanup</strong> — Event listeners properly disposed</li>
                <li><strong>Responsive Rendering</strong> — Conditional rendering based on viewport</li>
                <li><strong>Cross-Browser</strong> — Works with addEventListener and addListener (legacy)</li>
                <li><strong>Performance Optimized</strong> — Minimal overhead media query tracking</li>
                <li><strong>Clinical Applications</strong> — Adapt patient lists, dashboards, forms for device</li>
                <li><strong>Initialization Check</strong> — IsInitialized property to verify service readiness</li>
                <li><strong>Viewport Utilities</strong> — Additional JS functions for width, height detection</li>
                <li><strong>DotNet Interop</strong> — Seamless C# ↔ JavaScript communication</li>
            </ul>
        </section>

        <!-- Service Methods Reference -->
        <section class="demo-section">
            <h2>Service API Reference</h2>
            <div class="demo-box">
                <div class="api-reference">
                    <div class="api-method">
                        <h4>await InitializeAsync()</h4>
                        <p>Initializes the service and sets up media query listeners. Call once on app startup.</p>
                    </div>
                    <div class="api-method">
                        <h4>bool IsMobile { get; }</h4>
                        <p>Gets current mobile state (true if viewport &lt; 768px).</p>
                    </div>
                    <div class="api-method">
                        <h4>bool IsInitialized { get; }</h4>
                        <p>Indicates if service has been initialized.</p>
                    </div>
                    <div class="api-method">
                        <h4>event OnMobileStateChanged</h4>
                        <p>Fired when mobile state changes. Subscribe for re-rendering.</p>
                    </div>
                    <div class="api-method">
                        <h4>await DisposeAsync()</h4>
                        <p>Cleans up JS resources. Called automatically if component implements IAsyncDisposable.</p>
                    </div>
                </div>
            </div>
        </section>
    }
</div>

@code {
    private int ViewportWidth { get; set; } = 1024;

    protected override async Task OnInitializedAsync()
    {
        await MobileService.InitializeAsync();
        MobileService.OnMobileStateChanged += HandleMobileStateChanged;
        
        // Get initial viewport width via JS interop
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./Services/is-mobile.js");
            ViewportWidth = await module.InvokeAsync<int>("getWindowWidth");
        }
        catch
        {
            // Fallback width if JS fails
            ViewportWidth = 1024;
        }
    }

    private void HandleMobileStateChanged(object? sender, bool isMobile)
    {
        StateHasChanged();
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        MobileService.OnMobileStateChanged -= HandleMobileStateChanged;
        await ValueTask.CompletedTask;
    }

    [Inject]
    public IJSRuntime JS { get; set; } = default!;
}

