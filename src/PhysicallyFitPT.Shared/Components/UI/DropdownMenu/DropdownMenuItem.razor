@* Dropdown menu item - clickable menu item *@
@namespace PhysicallyFitPT.Shared.Components.UI
@implements IDisposable

<div class="dropdown-item @(Disabled ? "disabled" : "") @(isSelected ? "selected" : "")" 
     @onclick="HandleClick" 
     @attributes="AdditionalAttributes">
    @if (Icon != null)
    {
        <span class="dropdown-item-icon">@Icon</span>
    }
    <span class="dropdown-item-content">@ChildContent</span>
    @if (Shortcut != null)
    {
        <span class="dropdown-item-shortcut">@Shortcut</span>
    }
</div>

@code {
    [CascadingParameter]
    public DropdownMenu? ParentMenu { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Icon { get; set; }

    [Parameter]
    public RenderFragment? Shortcut { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool isSelected => ParentMenu?.IsItemSelected(Value ?? "") ?? false;

    protected override void OnInitialized()
    {
        if (ParentMenu != null && Value != null)
        {
            ParentMenu.RegisterItem(Value);
        }
    }

    private async Task HandleClick()
    {
        if (!Disabled && ParentMenu != null)
        {
            await OnClick.InvokeAsync();
            await ParentMenu.SetOpen(false);
        }
    }

    public void Dispose()
    {
        if (ParentMenu != null && Value != null)
        {
            ParentMenu.UnregisterItem(Value);
        }
    }
}
