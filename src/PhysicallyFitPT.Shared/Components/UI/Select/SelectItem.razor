@namespace PhysicallyFitPT.Shared.Components.UI

<button type="button"
        class="select-item"
        role="option"
        aria-selected="@(IsSelected ? "true" : "false")"
        disabled="@Disabled"
        @onclick="HandleSelect"
        @attributes="AdditionalAttributes">
    <span class="select-item-check" aria-hidden="true">
        @if (IsSelected)
        {
            <CheckIcon Width="16" Height="16" />
        }
    </span>
    <span class="select-item-label">@LabelToShow</span>
</button>

@code {
    [CascadingParameter]
    private Select? Select { get; set; }

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsSelected => Select?.IsSelected(Value) == true;
    private string LabelToShow => string.IsNullOrWhiteSpace(Label) ? Value : Label!;

    protected override void OnInitialized()
    {
        Select?.RegisterOption(Value, LabelToShow);
    }

    private Task HandleSelect()
    {
        if (Disabled || Select is null)
        {
            return Task.CompletedTask;
        }

        return Select.SelectAsync(Value, LabelToShow);
    }
}
