@* Demo page showing Button usage examples *@

<div class="space-y-8">
    <!-- Button Variants -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Button Variants</h3>
        <div class="flex flex-wrap items-center gap-3">
            <Button>Default</Button>
            <Button Variant="destructive">Destructive</Button>
            <Button Variant="outline">Outline</Button>
            <Button Variant="secondary">Secondary</Button>
            <Button Variant="ghost">Ghost</Button>
            <Button Variant="link">Link</Button>
        </div>
    </div>

    <!-- Button Sizes -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Button Sizes</h3>
        <div class="flex flex-wrap items-center gap-3">
            <Button Size="sm">Small</Button>
            <Button Size="default">Default</Button>
            <Button Size="lg">Large</Button>
        </div>
    </div>

    <!-- Buttons with Icons -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Buttons with Icons</h3>
        <div class="flex flex-wrap items-center gap-3">
            <Button>
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Add Patient
            </Button>
            <Button Variant="outline">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                </svg>
                Edit
            </Button>
            <Button Variant="destructive">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                Delete
            </Button>
            <Button Variant="secondary">
                Save
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            </Button>
        </div>
    </div>

    <!-- Icon-Only Buttons -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Icon-Only Buttons</h3>
        <div class="flex flex-wrap items-center gap-3">
            <Button Size="icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                </svg>
            </Button>
            <Button Size="icon" Variant="outline">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
            </Button>
            <Button Size="icon" Variant="destructive">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
            </Button>
            <Button Size="icon" Variant="ghost">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
            </Button>
        </div>
    </div>

    <!-- Disabled State -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Disabled State</h3>
        <div class="flex flex-wrap items-center gap-3">
            <Button Disabled="true">Default Disabled</Button>
            <Button Variant="outline" Disabled="true">Outline Disabled</Button>
            <Button Variant="destructive" Disabled="true">Destructive Disabled</Button>
        </div>
    </div>

    <!-- As Links -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Buttons as Links</h3>
        <div class="flex flex-wrap items-center gap-3">
            <Button AsLink="true" Href="/dashboard">Go to Dashboard</Button>
            <Button AsLink="true" Href="/patients" Variant="outline">View Patients</Button>
            <Button AsLink="true" Href="/settings" Variant="secondary">Settings</Button>
        </div>
    </div>

    <!-- Loading State -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Loading State</h3>
        <div class="flex flex-wrap items-center gap-3">
            <Button Disabled="true">
                <svg class="animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Loading...
            </Button>
            <Button Variant="outline" Disabled="true">
                <svg class="animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Processing
            </Button>
        </div>
    </div>

    <!-- Clinical Action Buttons -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Clinical Actions</h3>
        <div class="space-y-4">
            <!-- Primary Actions -->
            <div>
                <p class="text-xs text-gray-500 mb-2">Primary Actions</p>
                <div class="flex flex-wrap gap-2">
                    <Button>
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        New Patient
                    </Button>
                    <Button>
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        Schedule Appointment
                    </Button>
                    <Button>
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        Create SOAP Note
                    </Button>
                </div>
            </div>

            <!-- Secondary Actions -->
            <div>
                <p class="text-xs text-gray-500 mb-2">Secondary Actions</p>
                <div class="flex flex-wrap gap-2">
                    <Button Variant="outline">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                        Export Report
                    </Button>
                    <Button Variant="outline">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                        </svg>
                        Print
                    </Button>
                    <Button Variant="secondary">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                        </svg>
                        View Files
                    </Button>
                </div>
            </div>

            <!-- Destructive Actions -->
            <div>
                <p class="text-xs text-gray-500 mb-2">Destructive Actions</p>
                <div class="flex flex-wrap gap-2">
                    <Button Variant="destructive">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                        Cancel Appointment
                    </Button>
                    <Button Variant="destructive">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        Delete Note
                    </Button>
                </div>
            </div>
        </div>
    </div>

    <!-- Button Group -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Button Groups</h3>
        <div class="inline-flex rounded-md shadow-sm" role="group">
            <Button Class="rounded-r-none border-r-0" Variant="outline">Left</Button>
            <Button Class="rounded-none" Variant="outline">Middle</Button>
            <Button Class="rounded-l-none border-l-0" Variant="outline">Right</Button>
        </div>
    </div>

    <!-- Form Actions -->
    <div>
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Form Actions</h3>
        <div class="flex items-center justify-end gap-3 p-4 bg-gray-50 rounded-lg border border-gray-200">
            <Button Variant="ghost">Cancel</Button>
            <Button Variant="outline">Save as Draft</Button>
            <Button Type="submit">Submit</Button>
        </div>
    </div>
</div>

<style>
    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    
    .animate-spin {
        animation: spin 1s linear infinite;
    }
</style>

@code {
    // No state needed for static demos
}
