@* Responsive navigation menu that adapts to platform and screen size *@
@using PhysicallyFitPT.Shared

@inject IPlatformInfo PlatformInfo

<!-- Navigation Menu (positioned by ResponsiveMainLayout CSS) -->
<nav class="pfp-nav" role="navigation" aria-label="Main navigation">
  <!-- Profile Section -->
  <div class="pfp-nav-profile">
    <div class="pfp-nav-brand">
      <span class="pfp-nav-brand-text">PTDoc</span>
    </div>
    
    <div class="pfp-nav-profile-info">
      <div class="pfp-nav-profile-name">Dr. Sarah Johnson</div>
      <div class="pfp-nav-profile-role">Physical Therapist</div>
    </div>
    
    <div class="pfp-nav-profile-badge">
      <span class="pfp-nav-badge-text">PT</span>
    </div>
    
    <div class="pfp-nav-profile-actions">
      <button class="pfp-nav-icon-button" aria-label="Notifications">
        <span>🔔</span>
      </button>
      <button class="pfp-nav-icon-button" aria-label="Settings">
        <span>⚙️</span>
      </button>
    </div>
    
    <div class="pfp-nav-status-badge">
      <span>✓ Synced</span>
    </div>
  </div>

  <ul class="pfp-nav-list">
    <li class="pfp-nav-section-label">Main</li>
    
    <!-- MAIN: Dashboard (Active by default on app load) -->
    <li class="pfp-nav-item">
      <NavLink href="/" class="pfp-nav-link" Match="NavLinkMatch.All" @onclick="CloseMobileNav">
        <span class="pfp-nav-text">Dashboard</span>
      </NavLink>
    </li>
    
    <!-- MAIN: Appointments -->
    <li class="pfp-nav-item">
      <NavLink href="/appointments" class="pfp-nav-link" @onclick="CloseMobileNav">
        <span class="pfp-nav-text">Appointments</span>
      </NavLink>
    </li>
    
    <!-- MAIN: Patients -->
    <li class="pfp-nav-item">
      <NavLink href="/patients" class="pfp-nav-link" @onclick="CloseMobileNav">
        <span class="pfp-nav-text">Patients</span>
      </NavLink>
    </li>
    
    <!-- MAIN: Intake (with badge support) -->
    <li class="pfp-nav-item">
      <NavLink href="/intake" class="pfp-nav-link" @onclick="CloseMobileNav">
        <span class="pfp-nav-text">Intake</span>
        <span class="pfp-nav-badge pfp-nav-badge-destructive">1</span>
      </NavLink>
    </li>
    
    <!-- MAIN: Notes (with badge support) -->
    <li class="pfp-nav-item">
      <NavLink href="/notes/eval" class="pfp-nav-link" @onclick="CloseMobileNav">
        <span class="pfp-nav-text">Notes</span>
        <span class="pfp-nav-badge pfp-nav-badge-destructive">3</span>
      </NavLink>
    </li>
    
    <!-- MAIN: Progress Tracking (NEW) -->
    <li class="pfp-nav-item">
      <NavLink href="/progress-tracking" class="pfp-nav-link" @onclick="CloseMobileNav">
        <span class="pfp-nav-text">Progress Tracking</span>
      </NavLink>
    </li>
    
    <li class="pfp-nav-divider"></li>
    <li class="pfp-nav-section-label">Admin</li>
    
    <!-- ADMIN: Export Center (NEW) -->
    <li class="pfp-nav-item">
      <NavLink href="/admin/export-center" class="pfp-nav-link" @onclick="CloseMobileNav">
        <span class="pfp-nav-text">Export Center</span>
      </NavLink>
    </li>
    
    <!-- ADMIN: Reports (NEW) -->
    <li class="pfp-nav-item">
      <NavLink href="/admin/reports" class="pfp-nav-link" @onclick="CloseMobileNav">
        <span class="pfp-nav-text">Reports</span>
      </NavLink>
    </li>
    
    <!-- ADMIN: Role Management (NEW) -->
    <li class="pfp-nav-item">
      <NavLink href="/admin/role-management" class="pfp-nav-link" @onclick="CloseMobileNav">
        <span class="pfp-nav-text">Role Management</span>
      </NavLink>
    </li>
    
    <!-- ADMIN: Settings -->
    <li class="pfp-nav-item">
      <NavLink href="/admin/settings" class="pfp-nav-link" @onclick="CloseMobileNav">
        <span class="pfp-nav-text">Settings</span>
      </NavLink>
    </li>
  </ul>
  
  <!-- Logout Footer -->
  <div class="pfp-nav-footer">
    <button class="pfp-nav-link pfp-nav-logout" @onclick="HandleLogout">
      <span class="pfp-nav-text">Logout</span>
    </button>
  </div>
</nav>

@code {
  [Parameter] public bool IsCollapsed { get; set; }
  
  private void CloseMobileNav()
  {
    // Mobile drawer is handled by ResponsiveMainLayout CSS
  }
  
  private void HandleLogout()
  {
    // Handle logout logic
  }
}
